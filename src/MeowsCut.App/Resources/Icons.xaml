<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Векторные значки в системе координат 24×24. Отдельный словарь, потому что
         те же контуры нужны и кнопкам панели, и курсору мыши над доской монтажа. -->

    <!-- Стрелка выделения -->
    <PathGeometry x:Key="Icon.Pointer"
                  Figures="M 5,2 L 5,19.5 L 9.4,15.3 L 12.1,21.4 L 14.9,20.1 L 12.2,14.2 L 18.3,14 Z" />

    <!-- Ножницы: два кольца и перекрещенные лезвия. Рисуется обводкой, не заливкой. -->
    <PathGeometry x:Key="Icon.Scissors"
                  Figures="M 3,6 A 3,3 0 1 0 9,6 A 3,3 0 1 0 3,6 M 3,18 A 3,3 0 1 0 9,18 A 3,3 0 1 0 3,18 M 20,4 L 8.12,15.88 M 14.47,14.48 L 20,20 M 8.12,8.12 L 12,12" />

    <!-- Рука для протяжки доски -->
    <PathGeometry x:Key="Icon.Hand"
                  Figures="M 21,5.5 L 21,18 C 21,20.5 19,22.5 16.5,22.5 L 11,22.5 C 9.9,22.5 8.9,22.1 8.1,21.3 L 2.4,15.6 C 1.8,15 1.8,14 2.4,13.4 C 3,12.8 4,12.8 4.6,13.4 L 7.5,16.3 L 7.5,4.5 C 7.5,3.7 8.2,3 9,3 C 9.8,3 10.5,3.7 10.5,4.5 L 10.5,11 L 11.5,11 L 11.5,2.5 C 11.5,1.7 12.2,1 13,1 C 13.8,1 14.5,1.7 14.5,2.5 L 14.5,11 L 15.5,11 L 15.5,3.5 C 15.5,2.7 16.2,2 17,2 C 17.8,2 18.5,2.7 18.5,3.5 L 18.5,11 L 19.5,11 L 19.5,5.5 C 19.5,4.7 20.2,4 21,4 C 21,4 21,4.7 21,5.5 Z" />

    <!-- Разрез по плейхеду: две части и линия реза между ними -->
    <PathGeometry x:Key="Icon.Split"
                  Figures="M 3,6.5 L 9,6.5 L 9,17.5 L 3,17.5 Z M 15,6.5 L 21,6.5 L 21,17.5 L 15,17.5 Z M 12,2.5 L 12,21.5" />

    <!-- Корзина -->
    <PathGeometry x:Key="Icon.Trash"
                  Figures="M 4,6.5 L 20,6.5 M 9.5,3.5 L 14.5,3.5 M 6,6.5 L 7,20.5 L 17,20.5 L 18,6.5 M 10,10 L 10,17 M 14,10 L 14,17" />

    <!-- Плюс: добавить файл в видеоряд -->
    <PathGeometry x:Key="Icon.Plus" Figures="M 12,4 L 12,20 M 4,12 L 20,12" />

    <!-- Стрелки в стороны: вписать всю последовательность в окно -->
    <PathGeometry x:Key="Icon.Fit"
                  Figures="M 3,6 L 3,18 M 21,6 L 21,18 M 6,12 L 18,12 M 6,12 L 9.5,8.5 M 6,12 L 9.5,15.5 M 18,12 L 14.5,8.5 M 18,12 L 14.5,15.5" />

    <!-- Папка со стрелкой: «показать файл в проводнике» -->
    <PathGeometry x:Key="Icon.Folder"
                  Figures="M 2,5.5 C 2,4.7 2.7,4 3.5,4 L 9,4 L 11,6.5 L 20.5,6.5 C 21.3,6.5 22,7.2 22,8 L 22,18.5 C 22,19.3 21.3,20 20.5,20 L 3.5,20 C 2.7,20 2,19.3 2,18.5 Z" />

</ResourceDictionary>
