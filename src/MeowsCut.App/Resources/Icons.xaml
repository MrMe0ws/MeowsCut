<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Векторные значки в системе координат 24×24. Отдельный словарь, потому что
         те же контуры нужны и кнопкам панели, и курсору мыши над доской монтажа. -->

    <!-- Стрелка выделения -->
    <PathGeometry x:Key="Icon.Pointer"
                  Figures="M 5,2 L 5,19.5 L 9.4,15.3 L 12.1,21.4 L 14.9,20.1 L 12.2,14.2 L 18.3,14 Z" />

    <!-- Ножницы: два кольца и перекрещенные лезвия. Рисуется обводкой, не заливкой. -->
    <PathGeometry x:Key="Icon.Scissors"
                  Figures="M 3,6 A 3,3 0 1 0 9,6 A 3,3 0 1 0 3,6 M 3,18 A 3,3 0 1 0 9,18 A 3,3 0 1 0 3,18 M 20,4 L 8.12,15.88 M 14.47,14.48 L 20,20 M 8.12,8.12 L 12,12" />

    <!-- Рука для протяжки доски -->
    <PathGeometry x:Key="Icon.Hand"
                  Figures="M 21,5.5 L 21,18 C 21,20.5 19,22.5 16.5,22.5 L 11,22.5 C 9.9,22.5 8.9,22.1 8.1,21.3 L 2.4,15.6 C 1.8,15 1.8,14 2.4,13.4 C 3,12.8 4,12.8 4.6,13.4 L 7.5,16.3 L 7.5,4.5 C 7.5,3.7 8.2,3 9,3 C 9.8,3 10.5,3.7 10.5,4.5 L 10.5,11 L 11.5,11 L 11.5,2.5 C 11.5,1.7 12.2,1 13,1 C 13.8,1 14.5,1.7 14.5,2.5 L 14.5,11 L 15.5,11 L 15.5,3.5 C 15.5,2.7 16.2,2 17,2 C 17.8,2 18.5,2.7 18.5,3.5 L 18.5,11 L 19.5,11 L 19.5,5.5 C 19.5,4.7 20.2,4 21,4 C 21,4 21,4.7 21,5.5 Z" />

    <!-- Разрез по плейхеду: две части и линия реза между ними -->
    <PathGeometry x:Key="Icon.Split"
                  Figures="M 3,6.5 L 9,6.5 L 9,17.5 L 3,17.5 Z M 15,6.5 L 21,6.5 L 21,17.5 L 15,17.5 Z M 12,2.5 L 12,21.5" />

    <!-- Корзина -->
    <PathGeometry x:Key="Icon.Trash"
                  Figures="M 4,6.5 L 20,6.5 M 9.5,3.5 L 14.5,3.5 M 6,6.5 L 7,20.5 L 17,20.5 L 18,6.5 M 10,10 L 10,17 M 14,10 L 14,17" />

    <!-- Плюс: добавить файл в видеоряд -->
    <PathGeometry x:Key="Icon.Plus" Figures="M 12,4 L 12,20 M 4,12 L 20,12" />

    <!-- Стрелки в стороны: вписать всю последовательность в окно -->
    <PathGeometry x:Key="Icon.Fit"
                  Figures="M 3,6 L 3,18 M 21,6 L 21,18 M 6,12 L 18,12 M 6,12 L 9.5,8.5 M 6,12 L 9.5,15.5 M 18,12 L 14.5,8.5 M 18,12 L 14.5,15.5" />

    <!-- Нота: добавить звук -->
    <PathGeometry x:Key="Icon.Note"
                  Figures="M 9,18 A 3,2.5 0 1 0 9,13 A 3,2.5 0 1 0 9,18 M 12,15.5 L 12,4 L 20,2 L 20,13.5 M 17,16 A 3,2.5 0 1 0 17,11 A 3,2.5 0 1 0 17,16" />

    <!-- Стопка полос: ещё одна дорожка -->
    <PathGeometry x:Key="Icon.Layers"
                  Figures="M 3,7 L 21,7 M 3,12 L 21,12 M 3,17 L 21,17" />

    <!-- Папка со стрелкой: «показать файл в проводнике» -->
    <PathGeometry x:Key="Icon.Folder"
                  Figures="M 2,5.5 C 2,4.7 2.7,4 3.5,4 L 9,4 L 11,6.5 L 20.5,6.5 C 21.3,6.5 22,7.2 22,8 L 22,18.5 C 22,19.3 21.3,20 20.5,20 L 3.5,20 C 2.7,20 2,19.3 2,18.5 Z" />

    <!-- Спидометр: скорость клипа и скорость кодирования -->
    <PathGeometry x:Key="Icon.Speed"
                  Figures="M 3.5,17.5 A 9.5,9.5 0 1 1 20.5,17.5 M 12,13 L 16.5,8.5" />

    <!-- Динамик с волнами: громкость -->
    <PathGeometry x:Key="Icon.Volume"
                  Figures="M 3,9.5 L 6.5,9.5 L 11,5.5 L 11,18.5 L 6.5,14.5 L 3,14.5 Z M 14.5,9 A 4,4 0 0 1 14.5,15 M 17.5,6 A 8,8 0 0 1 17.5,18" />

    <!-- Тот же динамик, перечёркнутый: звук куска выключен -->
    <PathGeometry x:Key="Icon.VolumeOff"
                  Figures="M 3,9.5 L 6.5,9.5 L 11,5.5 L 11,18.5 L 6.5,14.5 L 3,14.5 Z M 15,9.5 L 21,14.5 M 21,9.5 L 15,14.5" />

    <!-- Клин вверх: нарастание звука. Зеркальный — затухание -->
    <PathGeometry x:Key="Icon.Fade" Figures="M 3,19 L 21,5 L 21,19 Z" />

    <PathGeometry x:Key="Icon.FadeOut" Figures="M 21,19 L 3,5 L 3,19 Z" />

    <!-- Плёнка: всё, что про картинку в экспорте -->
    <PathGeometry x:Key="Icon.Film"
                  Figures="M 3,5 L 21,5 L 21,19 L 3,19 Z M 7,5 L 7,19 M 17,5 L 17,19 M 3,12 L 7,12 M 17,12 L 21,12 M 3,8.5 L 7,8.5 M 3,15.5 L 7,15.5 M 17,8.5 L 21,8.5 M 17,15.5 L 21,15.5" />

    <!-- Рамка с углами: разрешение и кадрирование -->
    <!-- Надпись: буква «Т» на подчёркивании -->
    <PathGeometry x:Key="Icon.Text" Figures="M 6,6 L 18,6 M 12,6 L 12,17 M 8,20 L 16,20" />

    <!-- Поворот: дуга в три четверти круга со стрелкой на конце -->
    <PathGeometry x:Key="Icon.RotateRight"
                  Figures="M 19,12 A 7,7 0 1 1 12,5 M 9,2 L 12,5 L 9,8" />

    <PathGeometry x:Key="Icon.RotateLeft"
                  Figures="M 5,12 A 7,7 0 1 0 12,5 M 15,2 L 12,5 L 15,8" />

    <!--
        Полуоборот: замкнутая петля со стрелкой. Рисунок квадратный по габаритам —
        значок вписывается в квадрат по Stretch=Uniform, и широкая плоская дуга
        расплющилась бы в загогулину.
    -->
    <PathGeometry x:Key="Icon.RotateHalf"
                  Figures="M 12,5 A 7,7 0 1 1 11.6,5 M 9,2 L 12,5 L 9,8" />

    <PathGeometry x:Key="Icon.Frame"
                  Figures="M 3,8 L 3,5 L 6,5 M 18,5 L 21,5 L 21,8 M 21,16 L 21,19 L 18,19 M 6,19 L 3,19 L 3,16" />

    <!-- Ползунки: качество и прочие настройки -->
    <PathGeometry x:Key="Icon.Sliders"
                  Figures="M 4,7 L 20,7 M 4,12 L 20,12 M 4,17 L 20,17 M 9,7 A 1.8,1.8 0 1 0 9.01,7 M 15,12 A 1.8,1.8 0 1 0 15.01,12 M 7,17 A 1.8,1.8 0 1 0 7.01,17" />

    <!-- Экран с двумя строками внизу: субтитры -->
    <PathGeometry x:Key="Icon.Subtitles"
                  Figures="M 3,5 L 21,5 L 21,19 L 3,19 Z M 6,14.5 L 11,14.5 M 13.5,14.5 L 18,14.5 M 6,11 L 9,11 M 11.5,11 L 18,11" />

    <!-- Кристалл с ножками: аппаратное кодирование -->
    <PathGeometry x:Key="Icon.Chip"
                  Figures="M 7,7 L 17,7 L 17,17 L 7,17 Z M 10,3.5 L 10,7 M 14,3.5 L 14,7 M 10,17 L 10,20.5 M 14,17 L 14,20.5 M 3.5,10 L 7,10 M 3.5,14 L 7,14 M 17,10 L 20.5,10 M 17,14 L 20.5,14" />

    <!-- Коробка: контейнер файла -->
    <PathGeometry x:Key="Icon.Box"
                  Figures="M 12,3 L 21,7.5 L 21,16.5 L 12,21 L 3,16.5 L 3,7.5 Z M 3,7.5 L 12,12 L 21,7.5 M 12,12 L 12,21" />

    <!-- Кнопки окна. Рисуются тонкой линией, как в самой Windows -->
    <PathGeometry x:Key="Icon.WindowMinimize" Figures="M 5,12 L 19,12" />

    <PathGeometry x:Key="Icon.WindowMaximize" Figures="M 5.5,5.5 L 18.5,5.5 L 18.5,18.5 L 5.5,18.5 Z" />

    <!-- Восстановить: окно поверх своего же следа -->
    <PathGeometry x:Key="Icon.WindowRestore"
                  Figures="M 8,8 L 8,4.5 L 19.5,4.5 L 19.5,16 L 16,16 M 4.5,8 L 16,8 L 16,19.5 L 4.5,19.5 Z" />

    <PathGeometry x:Key="Icon.WindowClose" Figures="M 6,6 L 18,18 M 18,6 L 6,18" />

    <!--
        Значок перед подписью поля. Обводка приглушённым цветом: значок помогает
        найти нужную строку взглядом, но спорить с самой подписью не должен.
    -->
    <!-- Стрелка раскрывающегося раздела: вправо — свёрнут, вниз — раскрыт -->
    <PathGeometry x:Key="Icon.Chevron" Figures="M 9,5 L 16,12 L 9,19" />

    <Style x:Key="FieldIcon" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

</ResourceDictionary>
