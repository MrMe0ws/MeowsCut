<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MeowsCut.App.Converters"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:vm="clr-namespace:MeowsCut.App.ViewModels">

    <!-- Шаги перемотки: кадр стрелками, секунда с Shift и кнопками под кадром -->
    <sys:Double x:Key="Step.Frame">0.04</sys:Double>
    <sys:Double x:Key="Step.Frame.Back">-0.04</sys:Double>
    <sys:Double x:Key="Step.Second">1</sys:Double>
    <sys:Double x:Key="Step.Second.Back">-1</sys:Double>

    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    <conv:EnumLabelConverter x:Key="EnumLabel" />
    <conv:EnumToBooleanConverter x:Key="EnumToBool" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:ShareOfHeightConverter x:Key="ShareOfHeight" />
    <conv:ShareOfHeightThicknessConverter x:Key="ShareOfHeightMargin" />
    <conv:BoolToResourceConverter x:Key="ThemeGlyph" FalseKey="Icon.Moon" TrueKey="Icon.Sun" />
    <conv:BoolToResourceConverter x:Key="PlayGlyph" FalseKey="Icon.Play" TrueKey="Icon.Pause" />
    <conv:MultiplyConverter x:Key="ShareOfWidth" Factor="0.625" />
    <conv:ValuesEqualConverter x:Key="ValuesEqual" />
    <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />

    <!-- Списки форматов и кодеков показывают человеческие названия -->
    <DataTemplate x:Key="EnumLabelTemplate">
        <TextBlock Foreground="{DynamicResource Brush.Text}"
                   Text="{Binding Converter={StaticResource EnumLabel}}" />
    </DataTemplate>

    <!-- Подпись элемента по свойству Title. DisplayMemberPath в своём шаблоне
         ComboBox не доходит до выбранного элемента, и в поле попадает ToString(). -->
    <DataTemplate x:Key="TitleTemplate">
        <TextBlock Foreground="{DynamicResource Brush.Text}" Text="{Binding Title}" />
    </DataTemplate>

    <!-- Строка «поле — значение» в карточках информации о файле -->
    <DataTemplate x:Key="MediaFieldTemplate" DataType="{x:Type vm:MediaField}">
        <Grid Margin="0,0,0,7">
            <!-- Подпись фиксирована, значение занимает остаток и при нужде обрезается:
                 иначе длинное имя контейнера съедает подпись. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource Text.Muted}"
                       Text="{Binding Label}" />
            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource Text.Base}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Value}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
