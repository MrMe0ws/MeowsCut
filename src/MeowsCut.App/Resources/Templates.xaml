<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MeowsCut.App.Converters"
                    xmlns:vm="clr-namespace:MeowsCut.App.ViewModels">

    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    <conv:EnumLabelConverter x:Key="EnumLabel" />
    <conv:EnumToBooleanConverter x:Key="EnumToBool" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

    <!-- Списки форматов и кодеков показывают человеческие названия -->
    <DataTemplate x:Key="EnumLabelTemplate">
        <TextBlock Foreground="{StaticResource Brush.Text}"
                   Text="{Binding Converter={StaticResource EnumLabel}}" />
    </DataTemplate>

    <!-- Строка «поле — значение» в карточках информации о файле -->
    <DataTemplate x:Key="MediaFieldTemplate" DataType="{x:Type vm:MediaField}">
        <Grid Margin="0,0,0,7">
            <!-- Подпись фиксирована, значение занимает остаток и при нужде обрезается:
                 иначе длинное имя контейнера съедает подпись. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource Text.Muted}"
                       Text="{Binding Label}" />
            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource Text.Base}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Value}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
