<Window x:Class="MeowsCut.App.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="{loc:Tr Settings}"
        Width="620"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        SizeToContent="Height"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Кнопки закреплены внизу, остальное прокручивается: разделов стало много,
         и на экране ноутбука «Сохранить» иначе уезжала за край. -->
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Padding="0,0,6,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{loc:Tr Settings}" />

                <!-- FFmpeg -->
                <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Section}" Text="FFmpeg" />
                <TextBlock Style="{StaticResource Text.Muted}"
                           Text="{Binding ToolsetSummary}"
                           TextWrapping="Wrap" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding FfmpegDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseFfmpegCommand}"
                            Content="…"
                            Style="{StaticResource Button.Ghost}" />
                </Grid>
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr FfmpegPathHint}"
                           TextWrapping="Wrap" />

                <!-- Результаты -->
                <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Section}" Text="{loc:Tr SectionOutput}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseOutputCommand}"
                            Content="…"
                            Style="{StaticResource Button.Ghost}" />
                </Grid>
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr OutputFolderHint}"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Muted}" Text="{loc:Tr NameTemplate}" />
                <TextBox Text="{Binding OutputNameTemplate, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr NameTemplateHint}"
                           TextWrapping="Wrap" />

                <!-- Вид -->
                <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Section}" Text="{loc:Tr FieldTheme}" />

                <ComboBox Width="220"
                          HorizontalAlignment="Left"
                          ItemTemplate="{StaticResource TitleTemplate}"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding Theme}" />

                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr ThemeHint}"
                           TextWrapping="Wrap" />

                <!-- Запись голоса -->
                <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Section}" Text="{loc:Tr SectionRecording}" />

                <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldMicrophone}" />
                <ComboBox ItemTemplate="{StaticResource TitleTemplate}"
                          ItemsSource="{Binding Microphones}"
                          SelectedItem="{Binding Microphone}" />

                <CheckBox Margin="0,10,0,0"
                          Content="{loc:Tr MuteWhileRecording}"
                          IsChecked="{Binding MuteWhileRecording}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr MuteWhileRecordingHint}"
                           TextWrapping="Wrap" />

                <CheckBox Margin="0,10,0,0"
                          Content="{loc:Tr NoiseReduction}"
                          IsChecked="{Binding ReduceRecordingNoise}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr NoiseReductionHint}"
                           TextWrapping="Wrap" />

                <CheckBox Margin="0,10,0,0"
                          Content="{loc:Tr AdvancedSettings}"
                          IsChecked="{Binding ShowAdvancedRecording}" />

                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding ShowAdvancedRecording, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{loc:Tr RecordingOffset}" />
                        <TextBox Width="80"
                                 Margin="10,0,0,0"
                                 Text="{Binding RecordingOffsetMs, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr RecordingOffsetHint}"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,10,0,0"
                                IsEnabled="{Binding ReduceRecordingNoise}"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{loc:Tr NoiseReductionStrength}" />
                        <TextBox Width="80"
                                 Margin="10,0,0,0"
                                 Text="{Binding RecordingNoiseReductionDb, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr NoiseReductionStrengthHint}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Обслуживание -->
                <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Section}" Text="{loc:Tr SectionMaintenance}" />

                <CheckBox Content="{loc:Tr VerboseLogging}" IsChecked="{Binding VerboseLogging}" />

                <WrapPanel Margin="0,10,0,0">
                    <Button Margin="0,0,8,8"
                            Command="{Binding OpenLogsCommand}"
                            Content="{loc:Tr OpenLogs}"
                            Style="{StaticResource Button.Ghost}" />
                    <Button Margin="0,0,8,8"
                            Command="{Binding OpenPresetsFolderCommand}"
                            Content="{loc:Tr OpenPresetsFolder}"
                            Style="{StaticResource Button.Ghost}" />
                    <Button Margin="0,0,8,8"
                            Command="{Binding ReloadPresetsCommand}"
                            Content="{loc:Tr ReloadPresets}"
                            Style="{StaticResource Button.Ghost}" />
                    <Button Margin="0,0,8,8"
                            Command="{Binding ClearThumbnailCacheCommand}"
                            Content="{loc:Tr ClearCache}"
                            Style="{StaticResource Button.Ghost}" />
                </WrapPanel>

                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource Brush.Accent}"
                           Style="{StaticResource Text.Base}"
                           Text="{Binding Status}"
                           TextWrapping="Wrap" />

                <!-- О программе: версия, из чего собрано, куда идти за новой -->
                <TextBlock Margin="0,18,0,8" Style="{StaticResource Text.Section}" Text="{loc:Tr SectionAbout}" />

                <Border Padding="16"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Width="48"
                                   Height="48"
                                   Margin="0,0,14,0"
                                   VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="/MeowsCut;component/Assets/logo.png" />

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource Text.Base}"
                                               Text="{loc:Tr AppTitle}" />
                                    <Border Margin="10,0,0,0"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.AccentSoft}"
                                            CornerRadius="10">
                                        <TextBlock Foreground="{DynamicResource Brush.Accent}"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource Text.Caption}"
                                                   Text="{Binding AppVersion, Mode=OneTime}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource Text.Muted}"
                                           Text="{loc:Tr AboutTagline}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Style="{StaticResource Text.Mono}"
                                           Text="{Binding AboutComponents}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Text.Caption}"
                                           Text="{Binding AboutCopyright, Mode=OneTime}" />
                            </StackPanel>
                        </Grid>

                        <!-- Сеткой два на два: в строку четыре кнопки не влезают, а перенос рвал ряд -->
                        <UniformGrid Margin="0,14,-8,-8" Columns="2">
                            <Button Margin="0,0,8,8"
                                    Command="{Binding OpenProjectPageCommand}"
                                    Style="{StaticResource SoftButton}"
                                    ToolTip="{loc:Tr AboutProjectPageHint}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Open}" Style="{StaticResource GlyphLead}" />
                                    <TextBlock Text="{loc:Tr AboutProjectPage}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8"
                                    Command="{Binding OpenReleasesPageCommand}"
                                    Style="{StaticResource SoftButton}"
                                    ToolTip="{loc:Tr AboutReleasesHint}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Export}" Style="{StaticResource GlyphLead}" />
                                    <TextBlock Text="{loc:Tr AboutReleases}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8"
                                    Command="{Binding OpenAppFolderCommand}"
                                    Style="{StaticResource SoftButton}"
                                    ToolTip="{loc:Tr AboutAppFolderHint}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource GlyphLead}" />
                                    <TextBlock Text="{loc:Tr AboutAppFolder}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8"
                                    Command="{Binding OpenDataFolderCommand}"
                                    Style="{StaticResource SoftButton}"
                                    ToolTip="{loc:Tr AboutDataFolderHint}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource GlyphLead}" />
                                    <TextBlock Text="{loc:Tr AboutDataFolder}" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Click="OnClose" Content="{loc:Tr Close}" Style="{StaticResource Button.Ghost}" />
            <Button Margin="8,0,0,0"
                    Command="{Binding SaveCommand}"
                    Content="{loc:Tr SaveSettings}"
                    Style="{StaticResource Button.Primary}" />
        </StackPanel>
    </Grid>
</Window>
