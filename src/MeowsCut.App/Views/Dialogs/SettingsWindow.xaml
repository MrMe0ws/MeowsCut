<Window x:Class="MeowsCut.App.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="{loc:Tr Settings}"
        Width="620"
        SizeToContent="Height"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22">
        <TextBlock Style="{StaticResource Text.Title}" Text="{loc:Tr Settings}" />

        <!-- FFmpeg -->
        <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Section}" Text="FFmpeg" />
        <TextBlock Style="{StaticResource Text.Muted}"
                   Text="{Binding ToolsetSummary}"
                   TextWrapping="Wrap" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding FfmpegDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding BrowseFfmpegCommand}"
                    Content="…"
                    Style="{StaticResource Button.Ghost}" />
        </Grid>
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource Text.Muted}"
                   Text="{loc:Tr FfmpegPathHint}"
                   TextWrapping="Wrap" />

        <!-- Результаты -->
        <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Section}" Text="{loc:Tr SectionOutput}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding BrowseOutputCommand}"
                    Content="…"
                    Style="{StaticResource Button.Ghost}" />
        </Grid>
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource Text.Muted}"
                   Text="{loc:Tr OutputFolderHint}"
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Muted}" Text="{loc:Tr NameTemplate}" />
        <TextBox Text="{Binding OutputNameTemplate, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource Text.Muted}"
                   Text="{loc:Tr NameTemplateHint}"
                   TextWrapping="Wrap" />

        <!-- Обслуживание -->
        <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Section}" Text="{loc:Tr SectionMaintenance}" />

        <CheckBox Content="{loc:Tr VerboseLogging}" IsChecked="{Binding VerboseLogging}" />

        <WrapPanel Margin="0,10,0,0">
            <Button Margin="0,0,8,8"
                    Command="{Binding OpenLogsCommand}"
                    Content="{loc:Tr OpenLogs}"
                    Style="{StaticResource Button.Ghost}" />
            <Button Margin="0,0,8,8"
                    Command="{Binding OpenPresetsFolderCommand}"
                    Content="{loc:Tr OpenPresetsFolder}"
                    Style="{StaticResource Button.Ghost}" />
            <Button Margin="0,0,8,8"
                    Command="{Binding ReloadPresetsCommand}"
                    Content="{loc:Tr ReloadPresets}"
                    Style="{StaticResource Button.Ghost}" />
            <Button Margin="0,0,8,8"
                    Command="{Binding ClearThumbnailCacheCommand}"
                    Content="{loc:Tr ClearCache}"
                    Style="{StaticResource Button.Ghost}" />
        </WrapPanel>

        <TextBlock Margin="0,6,0,0"
                   Foreground="{StaticResource Brush.Accent}"
                   Style="{StaticResource Text.Base}"
                   Text="{Binding Status}"
                   TextWrapping="Wrap" />

        <StackPanel Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Click="OnClose" Content="{loc:Tr Close}" Style="{StaticResource Button.Ghost}" />
            <Button Margin="8,0,0,0"
                    Command="{Binding SaveCommand}"
                    Content="{loc:Tr SaveSettings}"
                    Style="{StaticResource Button.Primary}" />
        </StackPanel>
    </StackPanel>
</Window>
