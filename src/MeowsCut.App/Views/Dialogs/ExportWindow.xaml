<Window x:Class="MeowsCut.App.Views.Dialogs.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        xmlns:panes="clr-namespace:MeowsCut.App.Views.Panes"
        Title="{loc:Tr ExportStepTitle}"
        Width="1120"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Две колонки, а не одна лента сверху вниз: в узком окне до кнопки экспорта
         надо было листать через все настройки, и колесо проскакивало разделы. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="260" MaxWidth="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <panes:PresetsView x:Name="Presets" Grid.Column="0" />
        <panes:ExportPanelView x:Name="Export" Grid.Column="1" />
    </Grid>
</Window>
