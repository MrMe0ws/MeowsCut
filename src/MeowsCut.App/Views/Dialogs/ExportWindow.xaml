<Window x:Class="MeowsCut.App.Views.Dialogs.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MeowsCut.App.Controls"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        xmlns:panes="clr-namespace:MeowsCut.App.Views.Panes"
        xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ExportViewModel}"
        Title="{loc:Tr ExportDialogTitle}"
        Width="980"
        Height="780"
        MinWidth="860"
        MinHeight="560"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1"
        FontFamily="{StaticResource Font.Ui}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Окно в стиле модальной карточки: свой заголовок с крестиком, без системной рамки -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!--
        Экспорт 2.0. Слева — что получится и сколько весит, справа — решения
        сверху вниз в том порядке, в каком их принимают: весь ролик или кусок,
        пресет площадки, формат и качество, куда сохранить. Звук и редкие
        параметры кодирования — в раскрывающихся разделах. Главная кнопка
        одна и закреплена внизу: до неё не нужно листать.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Height="56" Padding="22,0,10,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button Click="OnClose"
                        DockPanel.Dock="Right"
                        Style="{StaticResource FlatIconButton}"
                        ToolTip="{loc:Tr ExportClose}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="13" Height="13" Data="{StaticResource Icon.WindowClose}" Style="{StaticResource Glyph}" />
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Style="{StaticResource Text.Base}" Text="{loc:Tr ExportDialogTitle}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Padding="20,18,10,18" controls:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto">
                <panes:ExportSummaryView />
            </ScrollViewer>

            <ScrollViewer Grid.Column="1"
                          Padding="12,18,22,18"
                          controls:SmoothScroll.IsEnabled="True"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <!-- Что уходит в файл: решение до всех настроек — промах тут дороже битрейта -->
                    <Border HorizontalAlignment="Stretch" Style="{StaticResource SegmentHost}">
                        <UniformGrid Rows="1">
                            <RadioButton Content="{loc:Tr ExportScopeWhole}"
                                         GroupName="Scope"
                                         IsChecked="{Binding WholeSequence}"
                                         Style="{StaticResource Segment}" />
                            <RadioButton Content="{loc:Tr ExportScopeSelection}"
                                         GroupName="Scope"
                                         IsChecked="{Binding SelectionOnly}"
                                         IsEnabled="{Binding HasSelectionRange}"
                                         Style="{StaticResource Segment}"
                                         ToolTip="{loc:Tr ExportScopeSelectionHint}"
                                         ToolTipService.ShowOnDisabled="True" />
                        </UniformGrid>
                    </Border>

                    <panes:PresetsView x:Name="Presets" Margin="0,4,0,0" />
                    <panes:ExportPanelView x:Name="Export" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Низ окна: проверка, ход экспорта и результат — вне прокрутки -->
        <panes:ExportFooterView Grid.Row="2" />
    </Grid>
</Window>
