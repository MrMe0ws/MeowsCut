<Window x:Class="MeowsCut.App.Views.Dialogs.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        Title="{loc:Tr AppTitle}"
        Width="560"
        MaxHeight="620"
        SizeToContent="Height"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Foreground="{StaticResource Brush.Danger}"
                   Style="{StaticResource Text.Title}"
                   Text="{Binding Title}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Style="{StaticResource Text.Base}"
                   Text="{Binding Message}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   Style="{StaticResource Text.Muted}"
                   Text="{Binding Suggestion}"
                   TextWrapping="Wrap"
                   Visibility="{Binding Suggestion, Converter={StaticResource NullToVisibility}}" />

        <!-- Технические подробности: доступны, но не лезут вперёд -->
        <Expander Grid.Row="3"
                  Margin="0,14,0,0"
                  Foreground="{StaticResource Brush.TextMuted}"
                  Header="{loc:Tr ErrorDetails}"
                  Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
            <Border Margin="0,8,0,0"
                    Background="{StaticResource Brush.SurfaceRaised}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBox Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             Foreground="{StaticResource Brush.Text}"
                             IsReadOnly="True"
                             Text="{Binding Details, Mode=OneWay}"
                             TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Expander>

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Click="OnCopyDetails"
                    Content="{loc:Tr CopyDetails}"
                    Style="{StaticResource Button.Ghost}"
                    Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}" />
            <Button Margin="8,0,0,0"
                    Click="OnOpenLogs"
                    Content="{loc:Tr OpenLogs}"
                    Style="{StaticResource Button.Ghost}" />
            <Button Margin="8,0,0,0"
                    Click="OnClose"
                    Content="{loc:Tr Close}"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}" />
        </StackPanel>
    </Grid>
</Window>
