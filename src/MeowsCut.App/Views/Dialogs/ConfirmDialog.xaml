<Window x:Class="MeowsCut.App.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        Title="{loc:Tr AppTitle}"
        Width="460"
        SizeToContent="Height"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Вопрос с двумя ответами. Системный MessageBox не знает про палитру
         редактора и в тёмной теме остаётся белым окном посреди экрана. -->
    <StackPanel Margin="22">
        <TextBlock Style="{StaticResource Text.Title}"
                   Text="{Binding Title}"
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,10,0,0"
                   Style="{StaticResource Text.Base}"
                   Text="{Binding Message}"
                   TextWrapping="Wrap" />

        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Click="OnDecline"
                    Content="{Binding DeclineText}"
                    Style="{StaticResource Button.Ghost}" />

            <Button Margin="10,0,0,0"
                    MinWidth="120"
                    Click="OnAccept"
                    Content="{Binding AcceptText}"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}" />
        </StackPanel>
    </StackPanel>
</Window>
