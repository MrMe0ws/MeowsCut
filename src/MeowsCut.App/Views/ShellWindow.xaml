<Window x:Class="MeowsCut.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MeowsCut.App.Controls"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        xmlns:panes="clr-namespace:MeowsCut.App.Views.Panes"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:timeline="clr-namespace:MeowsCut.App.Timeline"
        xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
        Title="{loc:Tr AppTitle}"
        Icon="../Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        AllowDrop="True"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        WindowStartupLocation="CenterScreen"
        DragOver="OnDragOver"
        Drop="OnDrop"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <!-- Горячие клавиши доски монтажа -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding Export.StartCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Timeline.UndoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding Timeline.RedoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Timeline.RedoCommand}" />
        <KeyBinding Key="S" Command="{Binding Timeline.SplitAtPlayheadCommand}" />
        <KeyBinding Key="Delete" Command="{Binding Timeline.DeleteSelectedCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding Timeline.DuplicateSelectedCommand}" />
        <KeyBinding Key="I" Command="{Binding Timeline.TrimStartToPlayheadCommand}" />
        <KeyBinding Key="O" Command="{Binding Timeline.TrimEndToPlayheadCommand}" />
        <KeyBinding Key="V" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static timeline:TimelineTool.Select}" />
        <KeyBinding Key="C" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static timeline:TimelineTool.Razor}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding Timeline.SelectAllCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding Timeline.CopySelectedCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding Timeline.CutSelectedCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding Timeline.PasteCommand}" />
        <KeyBinding Key="Left" Command="{Binding Preview.StepCommand}">
            <KeyBinding.CommandParameter>
                <sys:Double>-0.04</sys:Double>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="Right" Command="{Binding Preview.StepCommand}">
            <KeyBinding.CommandParameter>
                <sys:Double>0.04</sys:Double>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding Preview.StepCommand}">
            <KeyBinding.CommandParameter>
                <sys:Double>-1</sys:Double>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding Preview.StepCommand}">
            <KeyBinding.CommandParameter>
                <sys:Double>1</sys:Double>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="Space" Command="{Binding Preview.TogglePlayCommand}" />
        <KeyBinding Key="Home" Command="{Binding Preview.GoToStartCommand}" />
        <KeyBinding Key="End" Command="{Binding Preview.GoToEndCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Width="26"
                           Height="26"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="../Assets/logo.png" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Title}"
                               Text="{loc:Tr AppTitle}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Media.HeaderLine}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding CloseMediaCommand}"
                            Content="{loc:Tr CloseFile}"
                            Style="{StaticResource Button.Ghost}"
                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding OpenSettingsCommand}"
                            Content="⚙"
                            Style="{StaticResource Button.Ghost}"
                            ToolTip="{loc:Tr Settings}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Пустое состояние -->
        <Grid Grid.Row="1"
              Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="520"
                        Height="240"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="14"
                        Background="{StaticResource Brush.Surface}">
                    <Border.Resources>
                        <Style TargetType="Border">
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                        </Style>
                    </Border.Resources>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Width="76"
                               Height="76"
                               HorizontalAlignment="Center"
                               Opacity="0.9"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="../Assets/logo.png" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Style="{StaticResource Text.Base}"
                                   Text="{loc:Tr EmptyStateTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{loc:Tr EmptyStateOr}" />
                        <Button Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding OpenFileCommand}"
                                Content="{loc:Tr OpenVideo}"
                                IsEnabled="{Binding IsToolsetReady}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Border>

                <!-- Недавние файлы -->
                <StackPanel Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding RecentFiles.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Section}"
                               Text="{loc:Tr RecentFiles}" />
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentFileViewModel}">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding OpenCommand}"
                                        Content="{Binding FileName}"
                                        Style="{StaticResource Button.Ghost}"
                                        ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Рабочий экран: предпросмотр, доска монтажа и свойства выбранного куска -->
        <Grid Grid.Row="1" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="240" MinHeight="150" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Предпросмотр и колонка свойств справа от него: по бокам кадра
                 всё равно пустует место, а под доской монтажа полоса свойств
                 отъедала высоту у самой доски. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="330" MinWidth="220" MaxWidth="720" />
                </Grid.ColumnDefinitions>

                <panes:PreviewPaneView Grid.Column="0" DataContext="{Binding Preview}" />
                <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Vertical}" />

                <Border Grid.Column="2"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1,0,0,0">
                    <!-- Свойства и файлы делят колонку по вертикали: у одного бывает
                         десяток полей, у другого десяток файлов, и что важнее сейчас,
                         знает только пользователь. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="90" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" MinHeight="90" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      controls:SmoothScroll.IsEnabled="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <panes:InspectorView DataContext="{Binding Inspector}"
                                                     Visibility="{Binding DataContext.Timeline.HasAudioSelection,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource InverseBoolToVisibility}}" />
                                <panes:AudioInspectorView DataContext="{Binding AudioInspector}"
                                                          Visibility="{Binding DataContext.Timeline.HasAudioSelection,
                                                              RelativeSource={RelativeSource AncestorType=Window},
                                                              Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ScrollViewer>

                        <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Horizontal}" />
                        <panes:SourcesView Grid.Row="2" DataContext="{Binding Sources}" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Horizontal}" />
            <panes:TimelinePaneView Grid.Row="2" DataContext="{Binding Timeline}" />

            <!-- Финальный шаг. Настройки вывода живут в своём окне: за монтажом
                 они не нужны, а места занимали треть экрана. -->
            <Border Grid.Row="3"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding Timeline.SummaryLine}" />

                    <Button HorizontalAlignment="Right"
                            Command="{Binding OpenExportCommand}"
                            Content="{loc:Tr OpenExportStep}"
                            Style="{StaticResource Button.Primary}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Статусная строка -->
        <!-- Версия ffmpeg и кнопка выбора папки нужны, только когда что-то не так
             или идёт чтение файла. В обычной работе это техническая строка,
             занимающая высоту у доски монтажа. -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,8"
                Visibility="{Binding IsStatusBarVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding ToolsetStatus}" />

                <TextBlock Grid.Column="1"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr Reading}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <Button Grid.Column="2"
                        Command="{Binding ChooseFfmpegFolderCommand}"
                        Content="{loc:Tr FfmpegChooseFolder}"
                        Style="{StaticResource Button.Ghost}"
                        Visibility="{Binding IsToolsetReady, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
