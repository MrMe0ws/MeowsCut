<Window x:Class="MeowsCut.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MeowsCut.App.Controls"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        xmlns:panes="clr-namespace:MeowsCut.App.Views.Panes"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:timeline="clr-namespace:MeowsCut.App.Timeline"
        xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
        Title="{loc:Tr AppTitle}"
        Icon="../Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        AllowDrop="True"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnWindowStateChanged"
        DragOver="OnDragOver"
        Drop="OnDrop"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <!--
        Строка меню заменяет собой заголовок окна: отдельная полоса с одним
        названием программы занимала высоту ни за чем. Перетаскивание и двойной
        клик по свободному месту строки работают как у обычного заголовка.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Горячие клавиши доски монтажа -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding OpenExportCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Timeline.UndoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding Timeline.RedoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Timeline.RedoCommand}" />
        <KeyBinding Key="S" Command="{Binding Timeline.SplitAtPlayheadCommand}" />
        <KeyBinding Key="Delete" Command="{Binding Timeline.DeleteSelectedCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding Timeline.DuplicateSelectedCommand}" />
        <KeyBinding Key="I" Command="{Binding Timeline.TrimStartToPlayheadCommand}" />
        <KeyBinding Key="O" Command="{Binding Timeline.TrimEndToPlayheadCommand}" />
        <KeyBinding Key="V" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static timeline:TimelineTool.Select}" />
        <KeyBinding Key="C" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static timeline:TimelineTool.Razor}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding Timeline.SelectAllCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding Timeline.CopySelectedCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding Timeline.CutSelectedCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding Timeline.PasteCommand}" />
        <KeyBinding Key="Left" Command="{Binding Preview.StepCommand}">
            <KeyBinding.CommandParameter>
                <sys:Double>-0.04</sys:Double>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="Right" Command="{Binding Preview.StepCommand}">
            <KeyBinding.CommandParameter>
                <sys:Double>0.04</sys:Double>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding Preview.StepCommand}">
            <KeyBinding.CommandParameter>
                <sys:Double>-1</sys:Double>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding Preview.StepCommand}">
            <KeyBinding.CommandParameter>
                <sys:Double>1</sys:Double>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="Space" Command="{Binding Preview.TogglePlayCommand}" />
        <KeyBinding Key="Home" Command="{Binding Preview.GoToStartCommand}" />
        <KeyBinding Key="End" Command="{Binding Preview.GoToEndCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Строка меню. Характеристики файла отсюда убраны: они видны в списке
             файлов проекта, а сверху занимали высоту у доски монтажа. -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="18"
                       Height="18"
                       Margin="4,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="../Assets/logo.png" />

                <Menu Grid.Column="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="{loc:Tr MenuFile}">
                        <MenuItem Command="{Binding AddFileCommand}"
                                  Header="{loc:Tr MenuAddFile}"
                                  InputGestureText="Ctrl+O" />
                        <MenuItem Command="{Binding AddSoundCommand}" Header="{loc:Tr MenuAddAudio}" />
                        <Separator Style="{StaticResource MenuSeparator}" />
                        <MenuItem Command="{Binding OpenProjectCommand}" Header="{loc:Tr MenuOpenProject}" />
                        <MenuItem Command="{Binding SaveProjectCommand}"
                                  Header="{loc:Tr MenuSaveProject}"
                                  InputGestureText="Ctrl+S" />
                        <MenuItem Command="{Binding SaveProjectAsCommand}" Header="{loc:Tr MenuSaveProjectAs}" />
                        <Separator Style="{StaticResource MenuSeparator}" />
                        <MenuItem Command="{Binding OpenExportCommand}"
                                  Header="{loc:Tr MenuExport}"
                                  InputGestureText="Ctrl+E" />
                        <Separator Style="{StaticResource MenuSeparator}" />
                        <MenuItem Command="{Binding CloseMediaCommand}" Header="{loc:Tr MenuCloseFile}" />
                        <MenuItem Command="{Binding OpenSettingsCommand}" Header="{loc:Tr MenuSettings}" />
                        <Separator Style="{StaticResource MenuSeparator}" />
                        <MenuItem Click="OnExit" Header="{loc:Tr MenuExit}" />
                    </MenuItem>

                    <MenuItem Header="{loc:Tr MenuEdit}">
                        <MenuItem Command="{Binding Timeline.UndoCommand}"
                                  Header="{loc:Tr MenuUndo}"
                                  InputGestureText="Ctrl+Z" />
                        <MenuItem Command="{Binding Timeline.RedoCommand}"
                                  Header="{loc:Tr MenuRedo}"
                                  InputGestureText="Ctrl+Y" />
                        <Separator Style="{StaticResource MenuSeparator}" />
                        <MenuItem Command="{Binding Timeline.SplitAtPlayheadCommand}"
                                  Header="{loc:Tr MenuSplit}"
                                  InputGestureText="S" />
                        <MenuItem Command="{Binding Timeline.DuplicateSelectedCommand}"
                                  Header="{loc:Tr MenuDuplicate}"
                                  InputGestureText="Ctrl+D" />
                        <MenuItem Command="{Binding Timeline.DeleteSelectedCommand}"
                                  Header="{loc:Tr MenuDelete}"
                                  InputGestureText="Del" />
                    </MenuItem>
                </Menu>

                <!-- Имя черновика и кнопки окна -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               MaxWidth="240"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding ProjectFileName}"
                               TextTrimming="CharacterEllipsis" />

                    <Button Click="OnMinimize"
                            Style="{StaticResource WindowButton}"
                            Tag="{StaticResource Icon.WindowMinimize}"
                            ToolTip="{loc:Tr WindowMinimize}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton"
                            Click="OnMaximizeOrRestore"
                            Style="{StaticResource WindowButton}"
                            Tag="{StaticResource Icon.WindowMaximize}"
                            ToolTip="{loc:Tr WindowMaximize}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Click="OnExit"
                            Style="{StaticResource WindowButton.Close}"
                            Tag="{StaticResource Icon.WindowClose}"
                            ToolTip="{loc:Tr WindowClose}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Пустое состояние -->
        <Grid Grid.Row="1"
              Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="520"
                        Height="240"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="14"
                        Background="{DynamicResource Brush.Surface}">
                    <Border.Resources>
                        <Style TargetType="Border">
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                        </Style>
                    </Border.Resources>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Width="76"
                               Height="76"
                               HorizontalAlignment="Center"
                               Opacity="0.9"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="../Assets/logo.png" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Style="{StaticResource Text.Base}"
                                   Text="{loc:Tr EmptyStateTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{loc:Tr EmptyStateOr}" />
                        <Button Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding OpenFileCommand}"
                                Content="{loc:Tr OpenVideo}"
                                IsEnabled="{Binding IsToolsetReady}"
                                Style="{StaticResource Button.Primary}"
                                Visibility="{Binding IsPreparing, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Пока идёт подготовка, вместо серой кнопки видно, чем занято приложение -->
                        <StackPanel Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Path Style="{StaticResource Spinner}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Base}"
                                           Text="{loc:Tr StartupPreparing}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       MaxWidth="400"
                                       Style="{StaticResource Text.Muted}"
                                       Text="{loc:Tr StartupPreparingHint}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Недавние файлы -->
                <StackPanel Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding RecentFiles.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Section}"
                               Text="{loc:Tr RecentFiles}" />
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentFileViewModel}">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding OpenCommand}"
                                        Content="{Binding FileName}"
                                        Style="{StaticResource Button.Ghost}"
                                        ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Рабочий экран: предпросмотр, доска монтажа и свойства выбранного куска -->
        <Grid Grid.Row="1" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="240" MinHeight="150" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Предпросмотр и колонка свойств справа от него: по бокам кадра
                 всё равно пустует место, а под доской монтажа полоса свойств
                 отъедала высоту у самой доски. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="330" MinWidth="220" MaxWidth="720" />
                </Grid.ColumnDefinitions>

                <panes:PreviewPaneView Grid.Column="0" DataContext="{Binding Preview}" />
                <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Vertical}" />

                <Border Grid.Column="2"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1,0,0,0">
                    <!-- Свойства и файлы делят колонку по вертикали: у одного бывает
                         десяток полей, у другого десяток файлов, и что важнее сейчас,
                         знает только пользователь. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.7*" MinHeight="90" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" MinHeight="90" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      controls:SmoothScroll.IsEnabled="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <panes:InspectorView DataContext="{Binding Inspector}"
                                                     Visibility="{Binding DataContext.Timeline.HasAudioSelection,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource InverseBoolToVisibility}}" />
                                <panes:AudioInspectorView DataContext="{Binding AudioInspector}"
                                                          Visibility="{Binding DataContext.Timeline.HasAudioSelection,
                                                              RelativeSource={RelativeSource AncestorType=Window},
                                                              Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ScrollViewer>

                        <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Horizontal}" />
                        <panes:SourcesView Grid.Row="2" DataContext="{Binding Sources}" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Horizontal}" />
            <panes:TimelinePaneView Grid.Row="2" DataContext="{Binding Timeline}" />

            <!-- Финальный шаг. Настройки вывода живут в своём окне: за монтажом
                 они не нужны, а места занимали треть экрана. -->
            <Border Grid.Row="3"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding Timeline.SummaryLine}" />

                    <Button HorizontalAlignment="Right"
                            Command="{Binding OpenExportCommand}"
                            Content="{loc:Tr OpenExportStep}"
                            Style="{StaticResource Button.Primary}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Статусная строка -->
        <!-- Версия ffmpeg и кнопка выбора папки нужны, только когда что-то не так
             или идёт чтение файла. В обычной работе это техническая строка,
             занимающая высоту у доски монтажа. -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,8"
                Visibility="{Binding IsStatusBarVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding ToolsetStatus}" />

                <TextBlock Grid.Column="1"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr Reading}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <Button Grid.Column="2"
                        Command="{Binding ChooseFfmpegFolderCommand}"
                        Content="{loc:Tr FfmpegChooseFolder}"
                        Style="{StaticResource Button.Ghost}"
                        Visibility="{Binding IsToolsetReady, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>

        <!--
            Ожидание поверх всего окна. Чтение файла и открытие черновика занимают
            секунды, и без этого экран просто замирает — выглядит как зависшая
            программа. Панель перехватывает и клики: править то, что сейчас
            перечитывается, всё равно нельзя.
        -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Background="{DynamicResource Brush.Background}"
                Opacity="0.88"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Path Style="{StaticResource Spinner}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Base}"
                           Text="{Binding BusyText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
