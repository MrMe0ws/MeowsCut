<Window x:Class="MeowsCut.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        xmlns:panes="clr-namespace:MeowsCut.App.Views.Panes"
        xmlns:timeline="clr-namespace:MeowsCut.App.Timeline"
        xmlns:views="clr-namespace:MeowsCut.App.Views"
        xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
        Title="{loc:Tr AppTitle}"
        Icon="../Assets/app.ico"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="620"
        AllowDrop="True"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnWindowStateChanged"
        PreviewKeyDown="OnPreviewKeyDown"
        DragOver="OnDragOver"
        Drop="OnDrop"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <!--
        Строка меню заменяет собой заголовок окна. Перетаскивание и двойной клик
        по свободному месту строки работают как у обычного заголовка.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Горячие клавиши доски монтажа -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding OpenExportCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Timeline.UndoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding Timeline.RedoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Timeline.RedoCommand}" />
        <KeyBinding Key="S" Command="{Binding Timeline.SplitAtPlayheadCommand}" />
        <KeyBinding Key="Delete" Command="{Binding Timeline.DeleteSelectedCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding Timeline.DuplicateSelectedCommand}" />
        <KeyBinding Key="I" Command="{Binding Timeline.TrimStartToPlayheadCommand}" />
        <KeyBinding Key="O" Command="{Binding Timeline.TrimEndToPlayheadCommand}" />
        <KeyBinding Key="V" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static timeline:TimelineTool.Select}" />
        <KeyBinding Key="C" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static timeline:TimelineTool.Razor}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding Timeline.SelectAllCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding Timeline.CopySelectedCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding Timeline.CutSelectedCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding Timeline.PasteCommand}" />
        <KeyBinding Key="Left" Command="{Binding Preview.StepCommand}" CommandParameter="{StaticResource Step.Frame.Back}" />
        <KeyBinding Key="Right" Command="{Binding Preview.StepCommand}" CommandParameter="{StaticResource Step.Frame}" />
        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding Preview.StepCommand}" CommandParameter="{StaticResource Step.Second.Back}" />
        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding Preview.StepCommand}" CommandParameter="{StaticResource Step.Second}" />
        <KeyBinding Key="Space" Command="{Binding Preview.TogglePlayCommand}" />
        <KeyBinding Key="R" Command="{Binding Voiceover.ToggleRecordCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Voiceover.CancelCommand}" />
        <KeyBinding Key="Home" Command="{Binding Preview.GoToStartCommand}" />
        <KeyBinding Key="End" Command="{Binding Preview.GoToEndCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:ShellTitleBar x:Name="TitleBar" Grid.Row="0" />

        <!-- Пустое состояние -->
        <views:ShellEmptyState Grid.Row="1"
                               Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVisibility}}" />

        <!--
            Рабочий экран 2.0: медиа слева, кадр по центру, свойства справа,
            доска во всю ширину снизу. Панели — карточки на фоне окна; просветы
            между ними и есть разделители, их можно тянуть.
        -->
        <Grid x:Name="Workspace"
              Grid.Row="1"
              Margin="6,6,6,0"
              Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="BoardRow" Height="260" MinHeight="150" />
            </Grid.RowDefinitions>

            <Grid x:Name="TopArea" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MediaColumn" Width="264" MinWidth="200" MaxWidth="520" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SideColumn" Width="316" MinWidth="270" MaxWidth="620" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <panes:SourcesView x:Name="MediaPane" DataContext="{Binding Sources}" />
                </Border>

                <GridSplitter Grid.Column="1"
                              DragCompleted="OnSplitterDragCompleted"
                              Style="{StaticResource Splitter.Vertical}" />

                <!-- Крупный просмотр растягивает эту карточку поверх остальных (F11) -->
                <Border x:Name="PreviewCard"
                        Grid.Column="2"
                        Style="{StaticResource Panel}">
                    <panes:PreviewPaneView DataContext="{Binding Preview}" />
                </Border>

                <GridSplitter Grid.Column="3"
                              DragCompleted="OnSplitterDragCompleted"
                              Style="{StaticResource Splitter.Vertical}" />

                <Border Grid.Column="4" Style="{StaticResource Panel}">
                    <!-- Три инспектора на одном месте: свойства клипа, куска звука
                         и надписи. Одновременно выделено что-то одно. -->
                    <Grid>
                        <panes:InspectorView DataContext="{Binding Inspector}"
                                             Visibility="{Binding DataContext.Timeline.HasClipInspector,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />
                        <panes:AudioInspectorView DataContext="{Binding AudioInspector}"
                                                  Visibility="{Binding DataContext.Timeline.HasAudioSelection,
                                                      RelativeSource={RelativeSource AncestorType=Window},
                                                      Converter={StaticResource BoolToVisibility}}" />
                        <panes:TitleInspectorView DataContext="{Binding TitleInspector}"
                                                  Visibility="{Binding DataContext.Timeline.HasTitleSelection,
                                                      RelativeSource={RelativeSource AncestorType=Window},
                                                      Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="BoardSplitter"
                          Grid.Row="1"
                          DragCompleted="OnSplitterDragCompleted"
                          Style="{StaticResource Splitter.Horizontal}" />

            <Border Grid.Row="2" Margin="0,0,0,6" Style="{StaticResource Panel}">
                <panes:TimelinePaneView x:Name="TimelinePane" DataContext="{Binding Timeline}" />
            </Border>
        </Grid>

        <!-- Статусная строка: только когда что-то не так или идёт чтение файла -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,7"
                Visibility="{Binding IsStatusBarVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding ToolsetStatus}" />

                <TextBlock Grid.Column="1"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr Reading}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <Button Grid.Column="2"
                        Command="{Binding ChooseFfmpegFolderCommand}"
                        Content="{loc:Tr FfmpegChooseFolder}"
                        Style="{StaticResource Button.Ghost}"
                        Visibility="{Binding IsToolsetReady, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>

        <!--
            Ожидание поверх всего окна. Чтение файла и открытие черновика занимают
            секунды, и без этого экран просто замирает — выглядит как зависшая
            программа. Панель перехватывает и клики.
        -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Background="{DynamicResource Brush.Background}"
                Opacity="0.88"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Path Style="{StaticResource Spinner}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Base}"
                           Text="{Binding BusyText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
