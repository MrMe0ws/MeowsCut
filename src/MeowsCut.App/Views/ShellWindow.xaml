<Window x:Class="MeowsCut.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MeowsCut.App.Localization"
        xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
        Title="{loc:Tr AppTitle}"
        Icon="../Assets/logo.png"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        AllowDrop="True"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        WindowStartupLocation="CenterScreen"
        DragOver="OnDragOver"
        Drop="OnDrop"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Width="26"
                           Height="26"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="../Assets/logo.png" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Title}"
                               Text="{loc:Tr AppTitle}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Media.HeaderLine}" />

                <Button Grid.Column="2"
                        Command="{Binding CloseMediaCommand}"
                        Content="{loc:Tr CloseFile}"
                        Style="{StaticResource Button.Ghost}"
                        Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Пустое состояние -->
        <Grid Grid.Row="1"
              Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="520"
                        Height="240"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="14"
                        Background="{StaticResource Brush.Surface}">
                    <Border.Resources>
                        <Style TargetType="Border">
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                        </Style>
                    </Border.Resources>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Width="76"
                               Height="76"
                               HorizontalAlignment="Center"
                               Opacity="0.9"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="../Assets/logo.png" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Style="{StaticResource Text.Base}"
                                   Text="{loc:Tr EmptyStateTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{loc:Tr EmptyStateOr}" />
                        <Button Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding OpenFileCommand}"
                                Content="{loc:Tr OpenVideo}"
                                IsEnabled="{Binding IsToolsetReady}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Border>

                <!-- Недавние файлы -->
                <StackPanel Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding RecentFiles.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Section}"
                               Text="{loc:Tr RecentFiles}" />
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentFileViewModel}">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding OpenCommand}"
                                        Content="{Binding FileName}"
                                        Style="{StaticResource Button.Ghost}"
                                        ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Информация о файле -->
        <ScrollViewer Grid.Row="1"
                      Padding="24"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Media.FileName}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Muted}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Media.FilePath}" />

                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Media.Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Background="{StaticResource Brush.SurfaceRaised}"
                                    BorderBrush="{StaticResource Brush.Warning}"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="8"
                                    Padding="12,8">
                                <TextBlock Foreground="{StaticResource Brush.Warning}"
                                           Style="{StaticResource Text.Base}"
                                           TextWrapping="Wrap"
                                           Text="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <UniformGrid Margin="0,10,0,0" Columns="3" Rows="1">
                    <Border Margin="0,0,10,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr SectionFile}" />
                            <ItemsControl Margin="0,10,0,0"
                                          ItemsSource="{Binding Media.FileFields}"
                                          ItemTemplate="{StaticResource MediaFieldTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,10,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr SectionVideo}" />
                            <ItemsControl Margin="0,10,0,0"
                                          ItemsSource="{Binding Media.VideoFields}"
                                          ItemTemplate="{StaticResource MediaFieldTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr SectionAudio}" />
                            <ItemsControl Margin="0,10,0,0"
                                          ItemsSource="{Binding Media.AudioFields}"
                                          ItemTemplate="{StaticResource MediaFieldTemplate}" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource Text.Muted}"
                                       Text="{loc:Tr NoAudio}"
                                       Visibility="{Binding Media.HasAudio, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Статусная строка -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding ToolsetStatus}" />

                <TextBlock Grid.Column="1"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr Reading}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <Button Grid.Column="2"
                        Command="{Binding ChooseFfmpegFolderCommand}"
                        Content="{loc:Tr FfmpegChooseFolder}"
                        Style="{StaticResource Button.Ghost}"
                        Visibility="{Binding IsToolsetReady, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
