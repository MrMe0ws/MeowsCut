<UserControl x:Class="MeowsCut.App.Views.Panes.ExportFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ExportViewModel}">

    <!--
        Низ окна экспорта: «Проверить 5 секунд», ход экспорта и результат.
        Закреплён вне прокрутки — кнопки результата когда-то жили под всеми
        настройками, и до них надо было листать.
    -->
    <Border Padding="22,12"
            Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <Grid>
            <StackPanel>
                <TextBlock Margin="0,0,0,8"
                           Foreground="{DynamicResource Brush.Danger}"
                           Style="{StaticResource Text.Base}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                <DockPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <Button Command="{Binding PreviewFragmentCommand}" DockPanel.Dock="Left" Style="{StaticResource FlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Margin="0,0,8,0" Data="{StaticResource Icon.Play}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
                            <TextBlock Text="{loc:Tr PreviewFragment}" />
                        </StackPanel>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="OnClose" Content="{loc:Tr ExportClose}" Style="{StaticResource FlatButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding StartCommand}" Content="{loc:Tr StartExport}" Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </DockPanel>

                <!-- Ход экспорта: что сейчас делается, сколько прошло и осталось -->
                <Grid Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextMuted}" Style="{StaticResource Text.Mono}">
                                <Run Text="{loc:Tr Elapsed}" />
                                <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{loc:Tr Remaining}" />
                                <Run Text="{Binding RemainingText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Text.Base}" Text="{Binding ProgressStage}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Height="6" Margin="0,8,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CancelCommand}" Content="{loc:Tr CancelExport}" Style="{StaticResource Button.Ghost}" />
                </Grid>

                <!-- Готово: открыть результат — главная кнопка -->
                <DockPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Style="{StaticResource Text.Base}" Text="{loc:Tr ExportDone}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ResultSizeText}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding StartCommand}" Content="{loc:Tr ExportAgain}" Style="{StaticResource FlatButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding OpenResultCommand}" Content="{loc:Tr OpenResultFile}" Style="{StaticResource SoftButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding ShowInFolderCommand}" Style="{StaticResource Button.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Stroke="{DynamicResource Brush.OnAccent}" Style="{StaticResource GlyphLead}" />
                                <TextBlock Text="{loc:Tr OpenResultFolder}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
