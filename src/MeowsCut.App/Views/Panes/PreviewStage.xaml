<UserControl x:Class="MeowsCut.App.Views.Panes.PreviewStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PreviewViewModel}">

    <UserControl.Resources>
        <!-- «Заполнить кадр» — это Stretch у самой картинки: вписанное видео
             стоит с полями, заполняющее вылезает за кадр и обрезается рамкой.
             Стилем, а не значением в коде: проигрыватель создаётся один раз,
             а режим меняется по ходу работы. -->
        <Style TargetType="MediaElement">
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FrameFill}" Value="True">
                    <Setter Property="Stretch" Value="UniformToFill" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        Сам кадр последовательности: проигрыватель или картинка, надписи поверх
        и затемнение краёв. Кадр держит свои пропорции — в вертикальном формате
        видно и сам кадр 9:16, и то, что осталось за его краями.
    -->
    <controls:AspectFrame Margin="6" Aspect="{Binding FrameAspect}">
    <Grid>
    <Border Background="Black"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" />
    <controls:FramingHost OffsetX="{Binding FrameOffsetX}"
                          OffsetY="{Binding FrameOffsetY}"
                          Rotation="{Binding FrameRotation}"
                          Zoom="{Binding FrameZoom}">
    <Grid>
        <!-- Обычный режим: системный проигрыватель -->
        <ContentControl Content="{Binding PlayerVisual}"
                        Visibility="{Binding IsPlayerVisible, Converter={StaticResource BoolToVisibility}}" />

        <!-- Картинка: кадр из ffmpeg, если файл не открылся, или фотография
             из видеоряда — проигрыватель её показать не может -->
        <Image RenderOptions.BitmapScalingMode="HighQuality"
               Source="{Binding Frame}"
               Visibility="{Binding IsFrameVisible, Converter={StaticResource BoolToVisibility}}">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Stretch" Value="Uniform" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FrameFill}" Value="True">
                            <Setter Property="Stretch" Value="UniformToFill" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
    </Grid>
    </controls:FramingHost>

    <!-- Надписи поверх кадра: приблизительно, но на своих местах и своего
         размера. Без них титр впервые показался бы только в готовом файле. -->
    <ItemsControl x:Name="TitleLayer"
                  IsHitTestVisible="False"
                  ItemsSource="{Binding VisibleTitles}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Grid />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PreviewTitle}">
                <Border HorizontalAlignment="{Binding Horizontal}"
                        VerticalAlignment="{Binding Vertical}"
                        CornerRadius="2">
                    <Border.Margin>
                        <MultiBinding Converter="{StaticResource ShareOfHeightMargin}">
                            <Binding ElementName="TitleLayer" Path="ActualHeight" />
                            <Binding Path="Margin" />
                        </MultiBinding>
                    </Border.Margin>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Backdrop}" Value="True">
                                    <Setter Property="Background" Value="#8C000000" />
                                    <Setter Property="Padding" Value="6,2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock FontFamily="Segoe UI"
                               Foreground="{Binding Foreground}"
                               Text="{Binding Text}"
                               TextWrapping="NoWrap">
                        <TextBlock.FontSize>
                            <MultiBinding Converter="{StaticResource ShareOfHeight}">
                                <Binding ElementName="TitleLayer" Path="ActualHeight" />
                                <Binding Path="Scale" />
                            </MultiBinding>
                        </TextBlock.FontSize>
                    </TextBlock>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Затемнение поверх кадра: показывает затухание там же, где его
         выставляли, не дожидаясь экспорта. -->
    <Rectangle Fill="Black" IsHitTestVisible="False" Opacity="{Binding FadeDim}" />

    <!-- Рамка выделенного клипа: его кадр сейчас на экране. Тянуть мышью —
         сдвинуть кадр, колесо — масштаб. Те же правки, что в «Кадре» справа. -->
    <Grid x:Name="SelectionFrame"
          Background="Transparent"
          Cursor="SizeAll"
          ToolTip="{loc:Tr FrameEditHint}"
          Visibility="{Binding IsSelectedClipOnScreen, Converter={StaticResource BoolToVisibility}}"
          MouseLeftButtonDown="OnFrameMouseDown"
          MouseLeftButtonUp="OnFrameMouseUp"
          MouseMove="OnFrameMouseMove"
          MouseWheel="OnFrameWheel">
        <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5" />
        <Rectangle Width="9" Height="9" Margin="-4" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" />
        <Rectangle Width="9" Height="9" Margin="-4" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="White" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" />
        <Rectangle Width="9" Height="9" Margin="-4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="White" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" />
        <Rectangle Width="9" Height="9" Margin="-4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="White" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" />
    </Grid>
    </Grid>
    </controls:AspectFrame>
</UserControl>
