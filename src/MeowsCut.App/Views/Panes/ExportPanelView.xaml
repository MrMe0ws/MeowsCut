<UserControl x:Class="MeowsCut.App.Views.Panes.ExportPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:panes="clr-namespace:MeowsCut.App.Views.Panes"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ExportViewModel}">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Именованный стиль обязан наследовать тёмный: иначе он заменяет
             неявный шаблон целиком и список становится системным белым. -->
        <Style x:Key="FieldBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="controls:NumberBox" BasedOn="{StaticResource FieldNumber}" />
    </UserControl.Resources>

    <!--
        Настройки вывода под пресетом. На виду — то, что меняют почти всегда:
        формат, размер кадра, качество и куда сохранить. Звук с субтитрами и
        редкие параметры кодирования спрятаны в раскрывающиеся разделы,
        но не урезаны: всё, что было, на месте.
    -->
    <StackPanel>
        <TextBlock Style="{StaticResource ParamSection}" Text="{loc:Tr SectionFormatQuality}" />

        <UniformGrid Columns="3">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldContainerFormat}" />
                <ComboBox ItemTemplate="{StaticResource EnumLabelTemplate}" ItemsSource="{Binding Containers}" SelectedItem="{Binding Container}" Style="{StaticResource FieldBox}" />
            </StackPanel>
            <StackPanel Margin="4,0" Visibility="{Binding HasVideoOutput, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldResolution}" />
                <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" Style="{StaticResource FieldBox}" />
            </StackPanel>
            <StackPanel Margin="8,0,0,0" Visibility="{Binding HasVideoOutput, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldFrameRate}" />
                <ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding FrameRate}" Style="{StaticResource FieldBox}" />
            </StackPanel>
        </UniformGrid>

        <!-- Выбран MP3 или WAV: настройки картинки к такому файлу не относятся -->
        <TextBlock Margin="0,0,0,12"
                   Style="{StaticResource Text.Caption}"
                   Text="{loc:Tr ExportAudioOnlyNotice}"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsAudioOnly, Converter={StaticResource BoolToVisibility}}" />

        <Grid Margin="0,0,0,12" Visibility="{Binding IsCustomResolution, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Text="×" />
            <TextBox Grid.Column="2" Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{Binding FitModes}" SelectedItem="{Binding FitMode}" />
        </Grid>

        <TextBox Margin="0,0,0,12"
                 Text="{Binding CustomFps, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsCustomFrameRate, Converter={StaticResource BoolToVisibility}}" />

        <!-- Качество: режим и его значение. CRF — ползунком, где справа лучше картинка -->
        <StackPanel Visibility="{Binding HasVideoOutput, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldQuality}" />
            <ComboBox ItemsSource="{Binding QualityModes}" SelectedItem="{Binding QualityMode}" Style="{StaticResource FieldBox}" />

            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsQualityVisible, Converter={StaticResource BoolToVisibility}}">
                <controls:ParamRow Label="CRF" ToolTip="{loc:Tr CrfHint}">
                    <Slider IsDirectionReversed="True"
                            IsSnapToTickEnabled="True"
                            Maximum="51"
                            Minimum="0"
                            TickFrequency="1"
                            Value="{Binding Crf}" />
                    <controls:ParamRow.Trailing>
                        <controls:NumberBox Format="0" Maximum="51" Minimum="0" Step="1" Value="{Binding Crf}" />
                    </controls:ParamRow.Trailing>
                </controls:ParamRow>
                <Grid Margin="40,0,74,0">
                    <TextBlock FontSize="11" Style="{StaticResource Text.Caption}" Text="{loc:Tr CrfSmaller}" />
                    <TextBlock HorizontalAlignment="Right" FontSize="11" Style="{StaticResource Text.Caption}" Text="{loc:Tr CrfBetter}" />
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,12" Visibility="{Binding IsBitrateVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldBitrateKbps}" />
                <TextBox Text="{Binding BitrateKbps, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,12" Visibility="{Binding IsTargetSizeVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldTargetSize}" />
                <TextBox Text="{Binding TargetSizeMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{loc:Tr TargetSizeHint}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- Куда сохранить: путь и обычное окно выбора -->
        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldOutputFile}" />
        <DockPanel Margin="0,0,0,14">
            <Button Margin="8,0,0,0" Command="{Binding ChooseOutputCommand}" DockPanel.Dock="Right" Style="{StaticResource SoftButton}" ToolTip="{loc:Tr ExportTargetTitle}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource GlyphLead}" />
                    <TextBlock Text="{loc:Tr ChangeOutput}" />
                </StackPanel>
            </Button>
            <TextBox FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <Expander Margin="0,0,0,10" Style="{StaticResource Disclosure}">
            <Expander.Header>
                <TextBlock FontWeight="SemiBold" Style="{StaticResource Text.Base}" Text="{loc:Tr SectionSoundSubtitles}" />
            </Expander.Header>
            <panes:ExportSoundSection />
        </Expander>

        <Expander IsExpanded="{Binding ShowAdvanced}" Style="{StaticResource Disclosure}">
            <Expander.Header>
                <DockPanel>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{loc:Tr AdvancedHint}" />
                    <TextBlock FontWeight="SemiBold" Style="{StaticResource Text.Base}" Text="{loc:Tr AdvancedSettings}" />
                </DockPanel>
            </Expander.Header>
            <panes:ExportAdvancedSection />
        </Expander>
    </StackPanel>
</UserControl>
