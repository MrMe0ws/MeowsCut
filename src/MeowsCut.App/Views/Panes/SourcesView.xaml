<UserControl x:Class="MeowsCut.App.Views.Panes.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SourcesViewModel}">

    <!-- Что приложено к проекту. Стоит над свойствами в той же колонке: отсюда
         файл кладут на доску, и заглядывают сюда чаще, чем в поля свойств. -->
    <Border Padding="12,10"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,0,8"
                       Style="{StaticResource Text.Section}"
                       Text="{loc:Tr SectionSources}" />

            <ScrollViewer Grid.Row="1"
                          controls:SmoothScroll.IsEnabled="True"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectFileViewModel}">
                            <Border Margin="0,0,0,6"
                                    Padding="8,6"
                                    Background="{DynamicResource Brush.SurfaceRaised}"
                                    CornerRadius="6"
                                    ToolTip="{Binding Path}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource Text.Base}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Text.Muted}">
                                            <Run Text="{Binding Kind, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Details, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Button Padding="8,3"
                                                Command="{Binding AddCommand}"
                                                Content="+"
                                                Style="{StaticResource Button.Ghost}"
                                                ToolTip="{loc:Tr SourceAddToBoard}" />
                                        <Button Margin="4,0,0,0"
                                                Padding="8,3"
                                                Command="{Binding LocateCommand}"
                                                Style="{StaticResource Button.Ghost}"
                                                ToolTip="{loc:Tr SourceShowInFolder}">
                                            <Path Data="{StaticResource Icon.Folder}"
                                                  Style="{StaticResource ToolIconOnly}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
