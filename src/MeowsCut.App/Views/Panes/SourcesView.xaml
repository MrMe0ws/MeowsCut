<UserControl x:Class="MeowsCut.App.Views.Panes.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SourcesViewModel}">

    <UserControl.Resources>
        <!-- Меню файла по правой кнопке: то же, что кнопки, но без прицеливания -->
        <ContextMenu x:Key="FileMenu" x:Shared="False">
            <MenuItem Command="{Binding AddCommand}"
                      Header="{loc:Tr SourceAddToBoard}"
                      Icon="{StaticResource Icon.Plus}" />
            <MenuItem Command="{Binding LocateCommand}"
                      Header="{loc:Tr SourceShowInFolder}"
                      Icon="{StaticResource Icon.Folder}" />
        </ContextMenu>
    </UserControl.Resources>

    <!--
        Медиа проекта. Видео и фото — сеткой обложек: файл узнают по картинке,
        а не по имени вида PXL_20261018_065200711. Звук — списком под сеткой.
        Двойной щелчок или «+» на обложке кладёт файл на доску.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="14,8,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.PanelTitle}"
                       Text="{loc:Tr SectionMedia}" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding Count}" />

            <Button Grid.Column="2"
                    Command="{Binding DataContext.AddFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource AccentSoftButton}"
                    ToolTip="{loc:Tr ImportFilesHint}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Plus}" StrokeThickness="2.2" Style="{StaticResource GlyphLead}" />
                    <TextBlock Text="{loc:Tr ImportFiles}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Margin="12,0,12,10" Style="{StaticResource SegmentHost}">
            <UniformGrid Rows="1">
                <RadioButton Content="{loc:Tr FilterAll}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:SourceFilter.All}}"
                             Style="{StaticResource Segment}" />
                <RadioButton Content="{loc:Tr FilterVideo}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:SourceFilter.Video}}"
                             Style="{StaticResource Segment}" />
                <RadioButton Content="{loc:Tr FilterImage}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:SourceFilter.Image}}"
                             Style="{StaticResource Segment}" />
                <RadioButton Content="{loc:Tr FilterAudio}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:SourceFilter.Audio}}"
                             Style="{StaticResource Segment}" />
            </UniformGrid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Padding="12,0,8,0"
                      controls:SmoothScroll.IsEnabled="True"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding VisualFiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectFileViewModel}">
                            <Grid x:Name="Tile"
                                  Margin="0,0,8,12"
                                  Background="Transparent"
                                  ContextMenu="{StaticResource FileMenu}"
                                  Cursor="Hand"
                                  ToolTip="{Binding Hint}">
                                <Grid.InputBindings>
                                    <MouseBinding Command="{Binding AddCommand}" MouseAction="LeftDoubleClick" />
                                </Grid.InputBindings>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Обложка 16:10, пока её нет — значок вида файла -->
                                <Border x:Name="Cover"
                                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource ShareOfWidth}}"
                                        Background="{DynamicResource Brush.SurfaceRaised}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                    <Grid>
                                        <Path Width="22"
                                              Height="22"
                                              Data="{StaticResource Icon.Image}"
                                              Opacity="0.6"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource Brush.TextMuted}"
                                              StrokeThickness="1.5" />
                                        <Border CornerRadius="7">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>

                                        <!-- Галочка: файл уже лежит на доске -->
                                        <Border Width="18"
                                                Height="18"
                                                Margin="5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource Brush.Accent}"
                                                CornerRadius="9"
                                                ToolTip="{loc:Tr SourceOnBoardHint}"
                                                Visibility="{Binding IsOnBoard, Converter={StaticResource BoolToVisibility}}">
                                            <Path Width="10"
                                                  Height="10"
                                                  Data="{StaticResource Icon.Check}"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource Brush.OnAccent}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="2.6" />
                                        </Border>

                                        <Border Margin="5"
                                                Padding="5,1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="#A8000000"
                                                CornerRadius="4">
                                            <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="10"
                                                       Foreground="White"
                                                       Text="{Binding Badge}" />
                                        </Border>

                                        <!-- «+» появляется под курсором: положить на доску одним щелчком -->
                                        <Button x:Name="AddButton"
                                                Width="28"
                                                Height="28"
                                                Command="{Binding AddCommand}"
                                                Style="{StaticResource PlayButton}"
                                                ToolTip="{loc:Tr SourceAddToBoard}"
                                                Visibility="Collapsed">
                                            <Path Width="12"
                                                  Height="12"
                                                  Data="{StaticResource Icon.Plus}"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource Brush.OnAccent}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="2.6" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Margin="1,6,0,0"
                                           FontSize="12"
                                           Style="{StaticResource Text.Muted}"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AddButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Cover" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="2,8,10,12"
                           Style="{StaticResource Text.Caption}"
                           Text="{loc:Tr MediaEmpty}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Звук: у него нет кадра, поэтому списком. Высоту раздела тянут
             за его верхнюю границу: музыки в проекте бывает и одна, и двадцать. -->
        <Grid x:Name="SoundSection"
              Grid.Row="3"
              Visibility="{Binding HasAudioFiles, Converter={StaticResource BoolToVisibility}}">
            <Thumb VerticalAlignment="Top"
                   Panel.ZIndex="1"
                   DragCompleted="OnSoundResizeCompleted"
                   DragDelta="OnSoundResize"
                   Style="{StaticResource SectionResizer}"
                   ToolTip="{loc:Tr SoundSectionResizeHint}" />
            <DockPanel Margin="12,14,12,12">
                <TextBlock Margin="0,0,0,6"
                           DockPanel.Dock="Top"
                           Style="{StaticResource Text.Section}"
                           Text="{loc:Tr FilterAudio}" />
                <ScrollViewer controls:SmoothScroll.IsEnabled="True"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AudioFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectFileViewModel}">
                                <Border x:Name="Row"
                                        Margin="0,0,0,4"
                                        Padding="8,0,4,0"
                                        Background="{DynamicResource Brush.SurfaceRaised}"
                                        ContextMenu="{StaticResource FileMenu}"
                                        CornerRadius="8"
                                        Height="36"
                                        ToolTip="{Binding Hint}">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding AddCommand}" MouseAction="LeftDoubleClick" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Width="15"
                                              Height="15"
                                              Data="{StaticResource Icon.Note}"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource Brush.MusicMark}"
                                              StrokeThickness="1.6" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="9,0,6,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12.5"
                                                   Style="{StaticResource Text.Base}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Style="{StaticResource Text.Mono}"
                                                   Text="{Binding Badge}" />
                                        <Button Grid.Column="3"
                                                Width="28"
                                                Height="28"
                                                Command="{Binding AddCommand}"
                                                Style="{StaticResource FlatIconButton}"
                                                ToolTip="{loc:Tr SourceAddToBoard}">
                                            <Path Width="13" Height="13" Data="{StaticResource Icon.Plus}" Style="{StaticResource Glyph}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
