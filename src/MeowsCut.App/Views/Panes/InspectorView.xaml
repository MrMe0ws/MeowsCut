<UserControl x:Class="MeowsCut.App.Views.Panes.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:panes="clr-namespace:MeowsCut.App.Views.Panes"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InspectorViewModel}">

    <UserControl.Resources>
        <!-- Отпустили ползунок — склейка правок в истории заканчивается. Без этого
             вся работа за сеанс становилась одной записью, а Ctrl+Z возвращал
             кусок к исходному состоянию. -->
        <Style TargetType="Slider" BasedOn="{StaticResource Inspector.Slider}">
            <Setter Property="controls:SliderInteraction.EndCommand" Value="{Binding EndInteractionCommand}" />
        </Style>

        <Style TargetType="controls:NumberBox" BasedOn="{StaticResource FieldNumber}">
            <Setter Property="EndCommand" Value="{Binding EndInteractionCommand}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Ничего не выделено: подсказка, куда смотреть -->
        <StackPanel Margin="24,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
            <Path Width="28"
                  Height="28"
                  Data="{StaticResource Icon.Sliders}"
                  Opacity="0.7"
                  Stretch="Uniform"
                  Stroke="{DynamicResource Brush.TextMuted}"
                  StrokeThickness="1.4" />
            <TextBlock Margin="0,12,0,0"
                       Style="{StaticResource Text.Caption}"
                       Text="{loc:Tr InspectorEmptyHint}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Шапка: что выделено. Значок говорит, видео это или фото. -->
            <Grid Grid.Row="0" Margin="12,12,6,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        Background="{DynamicResource Brush.AccentSoft}"
                        CornerRadius="9">
                    <Path Width="19"
                          Height="19"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.Accent}"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.6">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource Icon.Film}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImageClip}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Icon.Image}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Style="{StaticResource Text.Base}"
                               Text="{Binding HeaderTitle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Clip.Title}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding HeaderDetails}" />
                </StackPanel>

                <!-- «⋯»: действия с куском, те же, что в меню по правой кнопке -->
                <Button Grid.Column="2"
                        controls:DropDownMenu.IsEnabled="True"
                        Style="{StaticResource FlatIconButton}"
                        Tag="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{loc:Tr InspectorMoreHint}">
                    <Path Data="{StaticResource Icon.More}" StrokeThickness="3" Style="{StaticResource Glyph}" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding PlacementTarget.Tag.SplitAtPlayheadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Header="{loc:Tr CtxSplit}"
                                      Icon="{StaticResource Icon.Split}"
                                      InputGestureText="S" />
                            <MenuItem Command="{Binding PlacementTarget.Tag.DuplicateSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Header="{loc:Tr CtxDuplicate}"
                                      Icon="{StaticResource Icon.Duplicate}"
                                      InputGestureText="Ctrl+D" />
                            <MenuItem Command="{Binding PlacementTarget.Tag.DetachAudioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Header="{loc:Tr CtxDetachAudio}"
                                      Icon="{StaticResource Icon.Note}" />
                            <Separator Style="{StaticResource MenuSeparator}" />
                            <MenuItem Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Header="{loc:Tr CtxDelete}"
                                      Icon="{StaticResource Icon.Trash}"
                                      InputGestureText="Del" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- Вкладки: что правят чаще — «Клип», реже — «Кадр» и «Звук» -->
            <Border Grid.Row="1"
                    Padding="8,0"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabClip"
                                 Content="{loc:Tr TabClip}"
                                 GroupName="InspectorTabs"
                                 IsChecked="True"
                                 Style="{StaticResource TabHeader}" />
                    <RadioButton x:Name="TabFrame"
                                 Content="{loc:Tr TabFrame}"
                                 GroupName="InspectorTabs"
                                 Style="{StaticResource TabHeader}" />
                    <RadioButton x:Name="TabSound"
                                 Content="{loc:Tr TabSound}"
                                 GroupName="InspectorTabs"
                                 Style="{StaticResource TabHeader}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Padding="14,12,12,14"
                          controls:SmoothScroll.IsEnabled="True"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Grid.IsSharedSizeScope="True">
                    <panes:ClipTabView Visibility="{Binding IsChecked, ElementName=TabClip, Converter={StaticResource BoolToVisibility}}" />
                    <panes:FrameTabView Visibility="{Binding IsChecked, ElementName=TabFrame, Converter={StaticResource BoolToVisibility}}" />
                    <panes:SoundTabView Visibility="{Binding IsChecked, ElementName=TabSound, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
