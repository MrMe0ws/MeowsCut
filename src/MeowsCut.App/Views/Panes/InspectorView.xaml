<UserControl x:Class="MeowsCut.App.Views.Panes.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InspectorViewModel}">

    <Border Padding="18,14"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1">
        <StackPanel>
            <TextBlock Margin="0,0,0,10"
                       Style="{StaticResource Text.Section}"
                       Text="{loc:Tr SectionClip}" />

            <TextBlock Style="{StaticResource Text.Muted}"
                       Text="{loc:Tr NoClipSelected}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldDuration}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Style="{StaticResource Text.Base}"
                               Text="{Binding DurationText}" />
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldOnTimeline}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Style="{StaticResource Text.Base}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding StartText, Mode=OneWay}" />
                        <Run Text="→" />
                        <Run Text="{Binding EndText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldInSource}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Style="{StaticResource Text.Base}"
                               Text="{Binding SourceRangeText}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldSpeed}" />
                <ItemsControl Margin="0,6,0,10" ItemsSource="{x:Static vm:InspectorViewModel.SpeedPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,6,6"
                                    Padding="10,4"
                                    Command="{Binding DataContext.ApplySpeedCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding StringFormat={}{0}×}"
                                    Style="{StaticResource Button.Ghost}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox Margin="0,0,0,8"
                          Content="{loc:Tr ClipAudioEnabled}"
                          IsChecked="{Binding AudioEnabled}" />

                <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldZoom}" />
                <Slider Margin="0,4,0,0"
                        IsSnapToTickEnabled="True"
                        Maximum="300"
                        Minimum="50"
                        TickFrequency="5"
                        Value="{Binding ZoomPercent}" />
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" />

                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldOffsetX}" />
                <Slider Margin="0,4,0,0"
                        Maximum="50"
                        Minimum="-50"
                        TickFrequency="5"
                        Value="{Binding OffsetXPercent}" />

                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldOffsetY}" />
                <Slider Margin="0,4,0,0"
                        Maximum="50"
                        Minimum="-50"
                        TickFrequency="5"
                        Value="{Binding OffsetYPercent}" />

                <Button Margin="0,6,0,10"
                        HorizontalAlignment="Left"
                        Command="{Binding ResetTransformCommand}"
                        Content="{loc:Tr ResetTransform}"
                        Style="{StaticResource Button.Ghost}" />

                <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldVolume}" />
                <Slider Margin="0,4,0,0"
                        IsSnapToTickEnabled="True"
                        Maximum="200"
                        Minimum="0"
                        TickFrequency="5"
                        Value="{Binding VolumePercent}" />
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding VolumePercent, StringFormat={}{0:0}%}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
