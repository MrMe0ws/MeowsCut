<UserControl x:Class="MeowsCut.App.Views.Panes.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InspectorViewModel}">

    <!-- Полоса под доской монтажа, а не колонка сбоку: свойства нужны ровно тогда,
         когда кусок выбран, и относятся к нему — место им рядом с ним. -->
    <Border Padding="12,8"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Muted}"
                       Text="{loc:Tr NoClipSelected}"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Section}"
                               Text="{loc:Tr SectionClip}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Base}"
                               Text="{Binding DurationText}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}">
                        <Run Text="{Binding StartText, Mode=OneWay}" />
                        <Run Text="→" />
                        <Run Text="{Binding EndText, Mode=OneWay}" />
                    </TextBlock>

                    <Border Width="1" Margin="12,2" Background="{StaticResource Brush.Border}" />

                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr FieldSpeed}" />
                    <ItemsControl VerticalAlignment="Center" ItemsSource="{x:Static vm:InspectorViewModel.SpeedPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,4,0"
                                        Padding="9,4"
                                        Command="{Binding DataContext.ApplySpeedCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding StringFormat={}{0}×}"
                                        Style="{StaticResource Button.Ghost}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Width="1" Margin="12,2" Background="{StaticResource Brush.Border}" />

                    <CheckBox VerticalAlignment="Center"
                              Content="{loc:Tr ClipAudioEnabled}"
                              IsChecked="{Binding AudioEnabled}" />
                    <Slider Width="90"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding AudioEnabled}"
                            IsSnapToTickEnabled="True"
                            Maximum="200"
                            Minimum="0"
                            TickFrequency="5"
                            ToolTip="{loc:Tr FieldVolume}"
                            Value="{Binding VolumePercent}" />
                    <TextBlock Width="40"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding VolumePercent, StringFormat={}{0:0}%}" />

                    <Border Width="1" Margin="12,2" Background="{StaticResource Brush.Border}" />

                    <ToggleButton x:Name="FrameToggle"
                                  Content="{loc:Tr SectionFrame}"
                                  Style="{StaticResource ToolButton}"
                                  ToolTip="{loc:Tr SectionFrameHint}" />
                </StackPanel>

                <!-- Кадрирование прячется: нужно редко, а места занимает как всё остальное -->
                <StackPanel Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding IsChecked, ElementName=FrameToggle,
                                Converter={StaticResource BoolToVisibility}}">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldZoom}" />
                    <Slider Width="110"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="300"
                            Minimum="50"
                            TickFrequency="5"
                            Value="{Binding ZoomPercent}" />
                    <TextBlock Width="44"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" />

                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr FieldOffsetX}" />
                    <Slider Width="90"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Maximum="50"
                            Minimum="-50"
                            TickFrequency="5"
                            Value="{Binding OffsetXPercent}" />

                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr FieldOffsetY}" />
                    <Slider Width="90"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Maximum="50"
                            Minimum="-50"
                            TickFrequency="5"
                            Value="{Binding OffsetYPercent}" />

                    <Button Margin="12,0,0,0"
                            Command="{Binding ResetTransformCommand}"
                            Content="{loc:Tr ResetTransform}"
                            Style="{StaticResource Button.Ghost}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
