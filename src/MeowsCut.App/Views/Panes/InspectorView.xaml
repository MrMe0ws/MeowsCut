<UserControl x:Class="MeowsCut.App.Views.Panes.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:fmt="clr-namespace:MeowsCut.App.Formatting"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InspectorViewModel}">

    <UserControl.Resources>
        <!-- Отпустили ползунок — склейка правок в истории заканчивается. Без этого
             вся работа со звуком за сеанс становилась одной записью, а Ctrl+Z
             возвращал кусок к исходному состоянию. -->
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="controls:SliderInteraction.EndCommand" Value="{Binding EndInteractionCommand}" />
        </Style>
    </UserControl.Resources>

    <!-- Годится и полосой под доской монтажа, и колонкой справа: строки переносятся
         по ширине. Полосой поля стоят в ряд, колонкой — складываются в столбик. -->
    <Border Padding="12,8"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Muted}"
                       Text="{loc:Tr NoClipSelected}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel Orientation="Horizontal">
                    <WrapPanel.Resources>
                        <!-- Зазор у каждой группы разом: колонкой справа они встают
                             друг под другом, и без него настройки слипаются. -->
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="0,4" />
                        </Style>
                    </WrapPanel.Resources>

                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Section}"
                               Text="{loc:Tr SectionClip}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Base}"
                               Text="{Binding DurationText}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}">
                        <Run Text="{Binding StartText, Mode=OneWay}" />
                        <Run Text="→" />
                        <Run Text="{Binding EndText, Mode=OneWay}" />
                    </TextBlock>

                    <Border Width="1" Margin="12,2" Background="{DynamicResource Brush.Border}" />

                    <!-- Ползунок и число — одной группой: порознь при переносе строки
                         число повисает отдельно от того, чем его меняют. -->
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Speed}" Style="{StaticResource FieldIcon}" />
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{loc:Tr FieldSpeed}" />
                        <Slider Width="120"
                                VerticalAlignment="Center"
                                LargeChange="1"
                                Maximum="{x:Static fmt:SpeedScale.Max}"
                                Minimum="{x:Static fmt:SpeedScale.Min}"
                                SmallChange="0.08"
                                ToolTip="{loc:Tr FieldSpeedHint}"
                                Value="{Binding SpeedSlider}" />
                        <TextBox Width="44"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 Padding="5,2"
                                 TextAlignment="Center"
                                 Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Tr FieldSpeedCustomHint}" />
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="×" />
                    </StackPanel>

                    <Border Width="1" Margin="12,2" Background="{DynamicResource Brush.Border}" />

                    <!-- Ползунок и его число — одной группой: при переносе строки
                         они обязаны остаться вместе, иначе «100%» повисает отдельно. -->
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Volume}" Style="{StaticResource FieldIcon}" />
                        <CheckBox VerticalAlignment="Center"
                                  Content="{loc:Tr ClipAudioEnabled}"
                                  IsChecked="{Binding AudioEnabled}" />
                        <Slider Width="90"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding AudioEnabled}"
                                IsSnapToTickEnabled="True"
                                Maximum="200"
                                Minimum="0"
                                TickFrequency="5"
                                ToolTip="{loc:Tr FieldVolume}"
                                Value="{Binding VolumePercent}" />
                        <TextBlock Width="40"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{Binding VolumePercent, StringFormat={}{0:0}%}" />
                    </StackPanel>

                    <Border Width="1" Margin="12,2" Background="{DynamicResource Brush.Border}" />

                    <ToggleButton x:Name="FrameToggle"
                                  Margin="0,4"
                                  Style="{StaticResource ToolButton}"
                                  ToolTip="{loc:Tr SectionFrameHint}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Frame}" Style="{StaticResource ToolIconStroke}" />
                            <TextBlock Text="{loc:Tr SectionFrame}" />
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>

                <!-- Кадрирование прячется: нужно редко, а места занимает как всё остальное -->
                <WrapPanel Margin="0,8,0,0"
                           Orientation="Horizontal"
                           Visibility="{Binding IsChecked, ElementName=FrameToggle,
                               Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Text="{loc:Tr FieldZoom}" />
                        <Slider Width="110"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="300"
                                Minimum="50"
                                TickFrequency="5"
                                Value="{Binding ZoomPercent}" />
                        <TextBlock Width="44"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" />
                    </StackPanel>

                    <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{loc:Tr FieldOffsetX}" />
                        <Slider Width="90"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="50"
                                Minimum="-50"
                                TickFrequency="5"
                                Value="{Binding OffsetXPercent}" />
                    </StackPanel>

                    <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{loc:Tr FieldOffsetY}" />
                        <Slider Width="90"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="50"
                                Minimum="-50"
                                TickFrequency="5"
                                Value="{Binding OffsetYPercent}" />
                    </StackPanel>

                    <Button Margin="12,0,0,0"
                            Command="{Binding ResetTransformCommand}"
                            Content="{loc:Tr ResetTransform}"
                            Style="{StaticResource Button.Ghost}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
