<UserControl x:Class="MeowsCut.App.Views.Panes.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:presets="clr-namespace:MeowsCut.Core.Presets;assembly=MeowsCut.Core"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PresetsViewModel}">

    <Border Padding="18,14"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1">
        <StackPanel>
            <TextBlock Margin="0,0,0,10"
                       Style="{StaticResource Text.Section}"
                       Text="{loc:Tr SectionPresets}" />

            <ComboBox Margin="0,0,0,8"
                      ItemTemplate="{StaticResource TitleTemplate}"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup}" />

            <ComboBox Margin="0,0,0,8"
                      ItemTemplate="{StaticResource TitleTemplate}"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset}" />

            <TextBlock Margin="0,0,0,8"
                       Style="{StaticResource Text.Muted}"
                       Text="{Binding SelectedPreset.Description}"
                       TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr DurationFitLabel}" />
            <ComboBox Margin="0,4,0,10"
                      ItemsSource="{Binding DurationFits}"
                      SelectedItem="{Binding DurationFit}" />

            <Button Command="{Binding ApplyCommand}"
                    Content="{loc:Tr ApplyPreset}"
                    Style="{StaticResource Button.Primary}" />

            <!-- Заметки пресета -->
            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,4"
                                   Style="{StaticResource Text.Muted}"
                                   Text="{Binding}"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Что именно пресет поменял -->
            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding Changes.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr PresetChanges}" />
                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,4"
                                       Foreground="{StaticResource Brush.Accent}"
                                       Style="{StaticResource Text.Base}"
                                       Text="{Binding}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Нарушения требований площадки -->
            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding Violations.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr PresetViolations}" />
                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Violations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type presets:ConstraintViolation}">
                            <TextBlock Margin="0,0,0,4"
                                       Foreground="{StaticResource Brush.Warning}"
                                       Style="{StaticResource Text.Base}"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Margin="0,6,0,0"
                        Command="{Binding FixViolationsCommand}"
                        Content="{loc:Tr FixViolations}"
                        Style="{StaticResource Button.Ghost}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
