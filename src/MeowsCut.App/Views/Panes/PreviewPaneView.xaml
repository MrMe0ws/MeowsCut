<UserControl x:Class="MeowsCut.App.Views.Panes.PreviewPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:panes="clr-namespace:MeowsCut.App.Views.Panes"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PreviewViewModel}">

    <!--
        Просмотр 2.0: формат кадра — над картинкой, транспорт — под ней,
        «Играть» — единственная залитая кнопка. Таймкод слева, моноширинный:
        цифры не дрожат при воспроизведении.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Формат ролика: это решение про монтаж, а не про экспорт — от него
             зависит, что вообще попадёт в кадр, и видно его сразу на кадре. -->
        <Grid Grid.Row="0" Margin="10,6,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Width="190"
                      ItemsSource="{Binding FormatOptions}"
                      SelectedItem="{Binding SelectedFormat}"
                      ToolTip="{loc:Tr FieldSequenceFormatHint}" />

            <TextBlock Grid.Column="1"
                       Margin="10,0,14,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Style="{StaticResource Text.Mono}"
                       Text="{Binding FrameSizeText}" />

            <CheckBox Grid.Column="2"
                      VerticalAlignment="Center"
                      Content="{loc:Tr FieldFillFrame}"
                      FontSize="12.5"
                      IsChecked="{Binding FillFrame}"
                      ToolTip="{loc:Tr FieldFillFrameHint}" />

            <!-- Увеличение кадра: рассмотреть фокус и мелкий текст. Только просмотр,
                 на монтаж и экспорт не влияет. Увеличенный кадр двигают мышью. -->
            <ComboBox x:Name="ZoomBox"
                      Grid.Column="3"
                      Width="104"
                      SelectedIndex="0"
                      SelectionChanged="OnZoomChanged"
                      ToolTip="{loc:Tr PreviewZoomHint}">
                <ComboBoxItem Content="{loc:Tr PreviewZoomFit}" Tag="1" />
                <ComboBoxItem Content="{loc:Tr PreviewZoom150}" Tag="1.5" />
                <ComboBoxItem Content="{loc:Tr PreviewZoom200}" Tag="2" />
                <ComboBoxItem Content="{loc:Tr PreviewZoom300}" Tag="3" />
            </ComboBox>
        </Grid>

        <Border x:Name="Stage"
                Grid.Row="1"
                Margin="10,0"
                Background="{DynamicResource Brush.Stage}"
                ClipToBounds="True"
                CornerRadius="8"
                MouseLeftButtonDown="OnStageMouseDown"
                MouseLeftButtonUp="OnStageMouseUp"
                MouseMove="OnStageMouseMove">
            <Grid x:Name="StageContent" Margin="10" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="StageScale" />
                        <TranslateTransform x:Name="StagePan" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <panes:PreviewStage x:Name="StageView" />
            </Grid>
        </Border>

        <!-- Транспорт -->
        <Grid Grid.Row="2" Height="62" Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Style="{StaticResource Text.Mono}"
                           Text="{Binding PositionText}" />
                <TextBlock Margin="6,0,0,1"
                           VerticalAlignment="Bottom"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Style="{StaticResource Text.Mono}">
                    <Run Text="/" />
                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Command="{Binding GoToStartCommand}" Style="{StaticResource FlatIconButton}" ToolTip="{loc:Tr GoToStartHint}">
                    <Path Data="{StaticResource Icon.ToStart}" Style="{StaticResource Glyph}" />
                </Button>
                <Button Command="{Binding StepCommand}"
                        CommandParameter="{StaticResource Step.Second.Back}"
                        Style="{StaticResource FlatIconButton}"
                        ToolTip="{loc:Tr StepBackHint}">
                    <Path Data="{StaticResource Icon.StepBack}" Style="{StaticResource Glyph}" />
                </Button>
                <Button Margin="8,0"
                        Command="{Binding TogglePlayCommand}"
                        Style="{StaticResource PlayButton}"
                        ToolTip="{loc:Tr PlayHint}">
                    <Path Width="16"
                          Height="16"
                          Data="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}"
                          Fill="{DynamicResource Brush.OnAccent}"
                          Stretch="Uniform" />
                </Button>
                <Button Command="{Binding StepCommand}"
                        CommandParameter="{StaticResource Step.Second}"
                        Style="{StaticResource FlatIconButton}"
                        ToolTip="{loc:Tr StepForwardHint}">
                    <Path Data="{StaticResource Icon.StepForward}" Style="{StaticResource Glyph}" />
                </Button>
                <Button Command="{Binding GoToEndCommand}" Style="{StaticResource FlatIconButton}" ToolTip="{loc:Tr GoToEndHint}">
                    <Path Data="{StaticResource Icon.ToEnd}" Style="{StaticResource Glyph}" />
                </Button>
            </StackPanel>

            <!-- Озвучка: модель записи живёт в оболочке, рядом с проектом -->
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        DataContext="{Binding DataContext.Voiceover, RelativeSource={RelativeSource AncestorType=Window}}"
                        Orientation="Horizontal">
                <Grid>
                    <Button Command="{Binding ToggleRecordCommand}"
                            Style="{StaticResource SoftButton}"
                            ToolTip="{loc:Tr RecordHint}"
                            Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Mic}" Style="{StaticResource GlyphLead}" />
                            <TextBlock Text="{loc:Tr Record}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="12,6"
                            Command="{Binding ToggleRecordCommand}"
                            Style="{StaticResource Button.Record}"
                            ToolTip="{loc:Tr RecordStopHint}"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Stop}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="{loc:Tr RecordStop}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Шумоподавление под рукой: включают его как раз перед дублем -->
                <ToggleButton Margin="4,0,0,0"
                              IsChecked="{Binding ReduceNoise}"
                              Style="{StaticResource FlatIconToggle}"
                              ToolTip="{loc:Tr NoiseReductionToggleHint}">
                    <Path Data="{StaticResource Icon.Denoise}" Style="{StaticResource Glyph}" />
                </ToggleButton>

                <ToggleButton Margin="2,0,0,0"
                              IsChecked="{Binding IsBigPreview, RelativeSource={RelativeSource AncestorType=Window}}"
                              Style="{StaticResource FlatIconToggle}"
                              ToolTip="{loc:Tr BigPreviewHint}">
                    <Path Data="{StaticResource Icon.Fullscreen}" Style="{StaticResource Glyph}" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <panes:PreviewRecordingBar Grid.Row="3"
                                   DataContext="{Binding DataContext.Voiceover, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Grid>
</UserControl>
