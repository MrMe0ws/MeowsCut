<UserControl x:Class="MeowsCut.App.Views.Panes.TimelinePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chips="clr-namespace:MeowsCut.App.Views.Chips"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:timeline="clr-namespace:MeowsCut.App.Timeline"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TimelineViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Панель доски 2.0: инструменты — значками (подпись и клавиша в подсказке),
            правка — значками, добавление — одной кнопкой с меню. Справа прилипание
            и масштаб. Строка переносится в узком окне, а не уезжает за край.
        -->
        <Border Grid.Row="0" Padding="10,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border VerticalAlignment="Center" Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Tool"
                                         IsChecked="{Binding ActiveTool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static timeline:TimelineTool.Select}}"
                                         Style="{StaticResource SegmentIcon}"
                                         ToolTip="{loc:Tr ToolSelectHint}">
                                <Path Data="{StaticResource Icon.Pointer}" StrokeThickness="1.5" Style="{StaticResource Glyph}" />
                            </RadioButton>
                            <RadioButton GroupName="Tool"
                                         IsChecked="{Binding ActiveTool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static timeline:TimelineTool.Razor}}"
                                         Style="{StaticResource SegmentIcon}"
                                         ToolTip="{loc:Tr ToolRazorHint}">
                                <Path Data="{StaticResource Icon.Scissors}" Style="{StaticResource Glyph}" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <Button Command="{Binding SplitAtPlayheadCommand}" Style="{StaticResource FlatIconButton}" ToolTip="{loc:Tr SplitHereHint}">
                        <Path Data="{StaticResource Icon.Split}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Command="{Binding DuplicateSelectedCommand}" Style="{StaticResource FlatIconButton}" ToolTip="{loc:Tr DuplicateHint}">
                        <Path Data="{StaticResource Icon.Duplicate}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource FlatIconButton}" ToolTip="{loc:Tr DeleteClipHint}">
                        <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource Glyph}" />
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- Всё, что кладут на доску, — одной кнопкой с меню -->
                    <Button controls:DropDownMenu.IsEnabled="True"
                            Style="{StaticResource SoftButton}"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{loc:Tr AddMenuHint}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Plus}" StrokeThickness="2" Style="{StaticResource GlyphLead}" />
                            <TextBlock Text="{loc:Tr AddMenu}" />
                            <Path Width="11" Height="11" Margin="6,1,0,0" Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Glyph}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding PlacementTarget.Tag.AddFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Header="{loc:Tr AddFile}"
                                          Icon="{StaticResource Icon.Film}"
                                          InputGestureText="Ctrl+O" />
                                <MenuItem Command="{Binding PlacementTarget.Tag.AddSoundCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Header="{loc:Tr AddSound}"
                                          Icon="{StaticResource Icon.Note}" />
                                <MenuItem Command="{Binding PlacementTarget.Tag.Timeline.AddAudioTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Header="{loc:Tr AddAudioTrack}"
                                          Icon="{StaticResource Icon.Layers}" />
                                <Separator Style="{StaticResource MenuSeparator}" />
                                <MenuItem Command="{Binding PlacementTarget.Tag.Timeline.AddTitleAtPlayheadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Header="{loc:Tr AddTitle}"
                                          Icon="{StaticResource Icon.Text}" />
                                <MenuItem Command="{Binding PlacementTarget.Tag.Voiceover.ToggleRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Header="{loc:Tr Voiceover}"
                                          Icon="{StaticResource Icon.Mic}"
                                          InputGestureText="R" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Margin="4,0,0,0" Command="{Binding AddTitleAtPlayheadCommand}" Style="{StaticResource FlatButton}" ToolTip="{loc:Tr AddTitleHint}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Text}" Style="{StaticResource GlyphLead}" />
                            <TextBlock Text="{loc:Tr AddTitle}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DataContext.RemoveSilenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource FlatButton}"
                            ToolTip="{loc:Tr RemoveSilenceHint}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Silence}" Style="{StaticResource GlyphLead}" />
                            <TextBlock Text="{loc:Tr RemoveSilence}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding SnapEnabled}" Style="{StaticResource FlatToggle}" ToolTip="{loc:Tr SnappingHint}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Magnet}" Style="{StaticResource GlyphLead}" />
                            <TextBlock Text="{loc:Tr Snapping}" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <Button Width="30" Command="{Binding ZoomOutCommand}" Style="{StaticResource FlatIconButton}" ToolTip="{loc:Tr ZoomOutHint}">
                        <Path Width="15" Height="15" Data="{StaticResource Icon.ZoomOut}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Slider Width="120"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Maximum="{x:Static vm:TimelineViewModel.ZoomLevelMax}"
                            Minimum="0"
                            SmallChange="2"
                            ToolTip="{loc:Tr ZoomSliderHint}"
                            Value="{Binding ZoomLevel}"
                            controls:ParamWheel.IsEnabled="True" />
                    <Button Width="30" Command="{Binding ZoomInCommand}" Style="{StaticResource FlatIconButton}" ToolTip="{loc:Tr ZoomInHint}">
                        <Path Width="15" Height="15" Data="{StaticResource Icon.Zoom}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Command="{Binding ZoomToFitCommand}" Style="{StaticResource FlatIconButton}" ToolTip="{loc:Tr ZoomFit}">
                        <Path Data="{StaticResource Icon.Fit}" Style="{StaticResource Glyph}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Значки полос слева, сама доска справа: одна раскладка на двоих -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:TrackHeaderStrip Grid.Column="0" />
            <controls:TimelineControl x:Name="Board" Grid.Column="1" ParameterRequested="OnParameterRequested" />
        </Grid>

        <!-- Чип параметра у куска: открывается из меню по правой кнопке, закрывается
             щелчком мимо или Esc. Правки идут через те же модели, что и панель свойств. -->
        <controls:ChipPopup x:Name="Chip" PlacementTarget="{Binding ElementName=Board}">
            <Border x:Name="ChipCard" Width="340" Style="{StaticResource FloatingCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="ChipClose"
                                Width="26"
                                Height="26"
                                Click="OnChipClose"
                                DockPanel.Dock="Right"
                                Style="{StaticResource FlatIconButton}"
                                ToolTip="{loc:Tr ChipCloseHint}">
                            <Path Width="11" Height="11" Data="{StaticResource Icon.WindowClose}" Style="{StaticResource Glyph}" />
                        </Button>
                        <Path x:Name="ChipIcon"
                              Width="16"
                              Height="16"
                              Margin="0,0,8,0"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Accent}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.7" />
                        <TextBlock x:Name="ChipTitle" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource Text.Base}" />
                    </DockPanel>

                    <chips:VideoChipEditors x:Name="VideoEditors" />
                    <chips:AudioChipEditors x:Name="AudioEditors" />
                    <chips:TitleChipEditors x:Name="TitleEditors" />
                </StackPanel>
            </Border>
        </controls:ChipPopup>
    </Grid>
</UserControl>
