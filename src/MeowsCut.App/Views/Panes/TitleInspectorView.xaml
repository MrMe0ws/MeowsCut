<UserControl x:Class="MeowsCut.App.Views.Panes.TitleInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TitleInspectorViewModel}">

    <UserControl.Resources>
        <Style TargetType="Slider" BasedOn="{StaticResource Inspector.Slider}">
            <Setter Property="controls:SliderInteraction.EndCommand" Value="{Binding EndInteractionCommand}" />
        </Style>

        <Style x:Key="FieldGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </UserControl.Resources>

    <!-- Свойства надписи. Раскладка та же, что у клипа и звука: подпись, орган,
         значение — переключение между ними не заставляет искать глазами заново. -->
    <Border Padding="12,10"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <StackPanel Grid.IsSharedSizeScope="True"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Section}"
                           Text="{loc:Tr SectionTitle}" />

                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding RangeText}" />
            </Grid>

            <!-- Текст многострочный: переносы строк drawtext рисует как есть -->
            <TextBox Margin="0,8,0,0"
                     MinHeight="52"
                     AcceptsReturn="True"
                     Padding="6,4"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <Border Style="{StaticResource Inspector.Separator}" />

            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource Inspector.Label}"
                           Text="{loc:Tr FieldTitleStart}" />

                <!-- Начало — числом, а не ползунком: у ролика в полчаса ползунок
                     не даёт попасть в нужную секунду, а надпись обычно двигают
                     мышью прямо на доске. -->
                <TextBox Grid.Column="1"
                         HorizontalAlignment="Left"
                         Width="70"
                         Padding="5,2"
                         TextAlignment="Center"
                         Text="{Binding StartSeconds, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}" />

                <TextBlock Grid.Column="2" Style="{StaticResource Inspector.Value}" Text="с" />
            </Grid>

            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource Inspector.Label}"
                           Text="{loc:Tr FieldTitleDuration}" />

                <Slider Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="20"
                        Minimum="0.3"
                        TickFrequency="0.1"
                        Value="{Binding DurationSeconds}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource Inspector.Value}"
                           Text="{Binding DurationSeconds, StringFormat={}{0:0.0} с}" />
            </Grid>

            <Border Style="{StaticResource Inspector.Separator}" />

            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource Inspector.Label}"
                           Text="{loc:Tr FieldTitlePlace}" />

                <ComboBox Grid.ColumnSpan="2"
                          Grid.Column="1"
                          Margin="0,2"
                          ItemsSource="{Binding Anchors}"
                          SelectedItem="{Binding Anchor}" />
            </Grid>

            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource Inspector.Label}"
                           Text="{loc:Tr FieldTitleSize}" />

                <Slider Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="30"
                        Minimum="2"
                        TickFrequency="0.5"
                        ToolTip="{loc:Tr FieldTitleSizeHint}"
                        Value="{Binding ScalePercent}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource Inspector.Value}"
                           Text="{Binding ScalePercent, StringFormat={}{0:0.#}%}" />
            </Grid>

            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource Inspector.Label}"
                           Text="{loc:Tr FieldTitleColor}" />

                <ComboBox Grid.ColumnSpan="2"
                          Grid.Column="1"
                          Margin="0,2"
                          ItemsSource="{Binding Colors}"
                          SelectedItem="{Binding Color}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <CheckBox VerticalAlignment="Center"
                          Content="{loc:Tr FieldTitleBackdrop}"
                          IsChecked="{Binding Backdrop}"
                          ToolTip="{loc:Tr FieldTitleBackdropHint}" />

                <Button HorizontalAlignment="Right"
                        Padding="8,2"
                        Command="{Binding RemoveCommand}"
                        Content="{loc:Tr RemoveTitle}"
                        Style="{StaticResource Button.Ghost}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
