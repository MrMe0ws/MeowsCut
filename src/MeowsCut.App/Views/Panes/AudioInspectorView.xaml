<UserControl x:Class="MeowsCut.App.Views.Panes.AudioInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:fmt="clr-namespace:MeowsCut.App.Formatting"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AudioInspectorViewModel}">

    <UserControl.Resources>
        <!-- Отпустили ползунок — склейка правок в истории заканчивается. Без этого
             вся работа со звуком за сеанс становилась одной записью, а Ctrl+Z
             возвращал кусок к исходному состоянию. -->
        <Style TargetType="Slider" BasedOn="{StaticResource Inspector.Slider}">
            <Setter Property="controls:SliderInteraction.EndCommand" Value="{Binding EndInteractionCommand}" />
        </Style>

        <Style x:Key="FieldGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </UserControl.Resources>

    <!-- Свойства выбранного куска звука. Раскладка та же, что у клипа: подпись,
         орган, значение — чтобы переключение между картинкой и звуком не требовало
         заново искать глазами, где что лежит. -->
    <Border Padding="12,10"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <StackPanel Grid.IsSharedSizeScope="True"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">

            <!-- Шапка: какой кусок и где он стоит -->
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr SectionSound}" />

            <TextBlock Margin="0,2,0,0"
                       Style="{StaticResource Text.Base}"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding RangeText}" />

            <Border Style="{StaticResource Inspector.Separator}" />

            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Volume}" Style="{StaticResource FieldIcon}" />
                    <TextBlock Style="{StaticResource Inspector.Label}" Text="{loc:Tr FieldGain}" />
                </StackPanel>

                <Slider Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="400"
                        Minimum="0"
                        TickFrequency="5"
                        Value="{Binding GainPercent}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource Inspector.Value}"
                           Text="{Binding GainPercent, StringFormat={}{0:0}%}" />
            </Grid>

            <!-- Скорость звука отдельно от скорости клипа: музыку подгоняют под
                 монтаж, а не наоборот, и от картинки она не зависит. -->
            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Speed}" Style="{StaticResource FieldIcon}" />
                    <TextBlock Style="{StaticResource Inspector.Label}" Text="{loc:Tr FieldSpeed}" />
                </StackPanel>

                <Slider Grid.Column="1"
                        LargeChange="1"
                        Maximum="{x:Static fmt:SpeedScale.Max}"
                        Minimum="{x:Static fmt:SpeedScale.Min}"
                        SmallChange="0.08"
                        ToolTip="{loc:Tr FieldSpeedHint}"
                        Value="{Binding SpeedSlider}" />

                <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal">
                    <TextBox Width="42"
                             VerticalAlignment="Center"
                             Padding="4,2"
                             TextAlignment="Center"
                             Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Tr FieldSpeedCustomHint}" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="×" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource FieldGrid}" ToolTip="{loc:Tr FieldPitchHint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Note}" Style="{StaticResource FieldIcon}" />
                    <TextBlock Style="{StaticResource Inspector.Label}" Text="{loc:Tr FieldPitch}" />
                </StackPanel>

                <Slider Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="12"
                        Minimum="-12"
                        TickFrequency="1"
                        Value="{Binding PitchSemitones}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource Inspector.Value}"
                           Text="{Binding PitchSemitones, StringFormat={}{0:+#;-#;0} пт}" />
            </Grid>

            <Border Style="{StaticResource Inspector.Separator}" />

            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr SectionFade}" />

            <Grid Style="{StaticResource FieldGrid}" ToolTip="{loc:Tr FieldFadeInHint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Fade}" Style="{StaticResource FieldIcon}" />
                    <TextBlock Style="{StaticResource Inspector.Label}" Text="{loc:Tr FieldFadeIn}" />
                </StackPanel>

                <Slider Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="5"
                        Minimum="0"
                        TickFrequency="0.1"
                        Value="{Binding FadeInSeconds}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource Inspector.Value}"
                           Text="{Binding FadeInSeconds, StringFormat={}{0:0.0} с}" />
            </Grid>

            <Grid Style="{StaticResource FieldGrid}" ToolTip="{loc:Tr FieldFadeOutHint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.FadeOut}" Style="{StaticResource FieldIcon}" />
                    <TextBlock Style="{StaticResource Inspector.Label}" Text="{loc:Tr FieldFadeOut}" />
                </StackPanel>

                <Slider Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="5"
                        Minimum="0"
                        TickFrequency="0.1"
                        Value="{Binding FadeOutSeconds}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource Inspector.Value}"
                           Text="{Binding FadeOutSeconds, StringFormat={}{0:0.0} с}" />
            </Grid>

            <Border Style="{StaticResource Inspector.Separator}" />

            <!-- Дорожка целиком: её громкость лежит поверх громкости кусков,
                 поэтому стоит отдельным разделом, а не рядом с ними. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Section}"
                           Text="{loc:Tr SectionTrack}" />

                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Base}"
                           Text="{Binding TrackTitle}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Style="{StaticResource FieldGrid}" ToolTip="{loc:Tr FieldTrackGainHint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource Inspector.Label}"
                           Text="{loc:Tr FieldGain}" />

                <Slider Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="400"
                        Minimum="0"
                        TickFrequency="5"
                        Value="{Binding TrackGainPercent}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource Inspector.Value}"
                           Text="{Binding TrackGainPercent, StringFormat={}{0:0}%}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <CheckBox VerticalAlignment="Center"
                          Command="{Binding ToggleMutedCommand}"
                          Content="{loc:Tr TrackMuted}"
                          IsChecked="{Binding TrackMuted}" />

                <Button HorizontalAlignment="Right"
                        Padding="8,2"
                        Command="{Binding RemoveTrackCommand}"
                        Content="{loc:Tr RemoveTrack}"
                        Style="{StaticResource Button.Ghost}" />
            </Grid>

            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource Text.Muted}"
                       Text="{loc:Tr AudioPreviewNote}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
