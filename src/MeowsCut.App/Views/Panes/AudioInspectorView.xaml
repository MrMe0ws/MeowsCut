<UserControl x:Class="MeowsCut.App.Views.Panes.AudioInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:fmt="clr-namespace:MeowsCut.App.Formatting"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AudioInspectorViewModel}">

    <UserControl.Resources>
        <!-- Отпустили ползунок — склейка правок в истории заканчивается -->
        <Style TargetType="Slider" BasedOn="{StaticResource Inspector.Slider}">
            <Setter Property="controls:SliderInteraction.EndCommand" Value="{Binding EndInteractionCommand}" />
        </Style>

        <Style TargetType="controls:NumberBox" BasedOn="{StaticResource FieldNumber}">
            <Setter Property="EndCommand" Value="{Binding EndInteractionCommand}" />
        </Style>
    </UserControl.Resources>

    <!-- Свойства выбранного куска звука. Раскладка та же, что у клипа: подпись,
         орган, значение — переключаясь между картинкой и звуком, не ищешь заново. -->
    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,12,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{DynamicResource Brush.AudioClip}" CornerRadius="9">
                <Path Width="18" Height="18" Data="{StaticResource Icon.Note}" Stretch="Uniform" Stroke="{DynamicResource Brush.MusicMark}" StrokeThickness="1.6" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Style="{StaticResource Text.Base}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding RangeText}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="14,4,12,14"
                      BorderBrush="{DynamicResource Brush.Border}"
                      controls:SmoothScroll.IsEnabled="True"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.IsSharedSizeScope="True">
                <controls:ParamRow Icon="{StaticResource Icon.Volume}" Label="{loc:Tr FieldGain}">
                    <Slider IsSnapToTickEnabled="True" Maximum="400" Minimum="0" TickFrequency="5" Value="{Binding GainPercent}" />
                    <controls:ParamRow.Trailing>
                        <controls:NumberBox Format="0" Maximum="400" Minimum="0" Step="1" Suffix="%" Value="{Binding GainPercent}" />
                    </controls:ParamRow.Trailing>
                </controls:ParamRow>

                <!-- Скорость звука отдельно от скорости клипа: музыку подгоняют под
                     монтаж, а не наоборот -->
                <TextBlock Style="{StaticResource ParamSection}" Text="{loc:Tr FieldSpeed}" />
                <ItemsControl ItemsSource="{Binding SpeedPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChoiceChip}">
                            <Button Margin="0,0,4,0" Command="{Binding PickCommand}" Content="{Binding Title}" Style="{StaticResource Chip}" Tag="{Binding IsActive}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:ParamRow Margin="0,8,0,3" Icon="{StaticResource Icon.Speed}" Label="{loc:Tr FieldSpeed}" ToolTip="{loc:Tr FieldSpeedHint}">
                    <Slider LargeChange="1"
                            Maximum="{x:Static fmt:SpeedScale.Max}"
                            Minimum="{x:Static fmt:SpeedScale.Min}"
                            SmallChange="0.08"
                            Value="{Binding SpeedSlider}" />
                    <controls:ParamRow.Trailing>
                        <controls:NumberBox Format="0.##" Maximum="16" Minimum="0.1" Step="0.05" Suffix="×" ToolTip="{loc:Tr FieldSpeedCustomHint}" Value="{Binding Speed}" />
                    </controls:ParamRow.Trailing>
                </controls:ParamRow>

                <!-- Тональность: готовые интервалы и любое число полутонов -->
                <TextBlock Style="{StaticResource ParamSection}" Text="{loc:Tr FieldPitch}" ToolTip="{loc:Tr FieldPitchHint}" />
                <ItemsControl x:Name="PitchChips" ItemsSource="{x:Static vm:AudioInspectorViewModel.PitchPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,3,0"
                                    Padding="2,0"
                                    Command="{Binding DataContext.ApplyPitchCommand, ElementName=PitchChips}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding StringFormat={}{0:+#;-#;0}}"
                                    Style="{StaticResource Chip}">
                                <Button.Tag>
                                    <MultiBinding Converter="{StaticResource ValuesEqual}">
                                        <Binding />
                                        <Binding ElementName="PitchChips" Path="DataContext.PitchSemitones" />
                                    </MultiBinding>
                                </Button.Tag>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:ParamRow Margin="0,8,0,3" Icon="{StaticResource Icon.Note}" Label="{loc:Tr FieldPitch}">
                    <Slider IsSnapToTickEnabled="True" Maximum="12" Minimum="-12" TickFrequency="1" Value="{Binding PitchSemitones}" />
                    <controls:ParamRow.Trailing>
                        <controls:NumberBox Format="+#;-#;0" Maximum="12" Minimum="-12" Step="1" Suffix=" пт" Value="{Binding PitchSemitones}" />
                    </controls:ParamRow.Trailing>
                </controls:ParamRow>

                <TextBlock Style="{StaticResource ParamSection}" Text="{loc:Tr SectionFade}" />
                <controls:ParamRow Icon="{StaticResource Icon.Fade}" Label="{loc:Tr FieldFadeIn}" ToolTip="{loc:Tr FieldFadeInHint}">
                    <Slider IsSnapToTickEnabled="True" Maximum="{Binding MaxFadeSeconds}" Minimum="0" TickFrequency="0.1" Value="{Binding FadeInSeconds}" />
                    <controls:ParamRow.Trailing>
                        <controls:NumberBox Format="0.0" Maximum="{Binding MaxFadeSeconds}" Minimum="0" Step="0.1" Suffix=" с" Value="{Binding FadeInSeconds}" />
                    </controls:ParamRow.Trailing>
                </controls:ParamRow>
                <controls:ParamRow Icon="{StaticResource Icon.FadeOut}" Label="{loc:Tr FieldFadeOut}" ToolTip="{loc:Tr FieldFadeOutHint}">
                    <Slider IsSnapToTickEnabled="True" Maximum="{Binding MaxFadeSeconds}" Minimum="0" TickFrequency="0.1" Value="{Binding FadeOutSeconds}" />
                    <controls:ParamRow.Trailing>
                        <controls:NumberBox Format="0.0" Maximum="{Binding MaxFadeSeconds}" Minimum="0" Step="0.1" Suffix=" с" Value="{Binding FadeOutSeconds}" />
                    </controls:ParamRow.Trailing>
                </controls:ParamRow>

                <!-- Дорожка целиком: её громкость лежит поверх громкости кусков -->
                <Grid Margin="0,16,0,6">
                    <TextBlock Margin="0" Style="{StaticResource ParamSection}" Text="{loc:Tr SectionTrack}" />
                    <TextBlock Margin="60,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding TrackTitle}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <controls:ParamRow Icon="{StaticResource Icon.Layers}" Label="{loc:Tr FieldGain}" ToolTip="{loc:Tr FieldTrackGainHint}">
                    <Slider IsSnapToTickEnabled="True" Maximum="400" Minimum="0" TickFrequency="5" Value="{Binding TrackGainPercent}" />
                    <controls:ParamRow.Trailing>
                        <controls:NumberBox Format="0" Maximum="400" Minimum="0" Step="1" Suffix="%" Value="{Binding TrackGainPercent}" />
                    </controls:ParamRow.Trailing>
                </controls:ParamRow>
                <Grid Margin="0,8,0,0">
                    <CheckBox VerticalAlignment="Center" Command="{Binding ToggleMutedCommand}" Content="{loc:Tr TrackMuted}" IsChecked="{Binding TrackMuted}" />
                    <Button HorizontalAlignment="Right" Command="{Binding RemoveTrackCommand}" Style="{StaticResource FlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource GlyphLead}" />
                            <TextBlock Text="{loc:Tr RemoveTrack}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}" Text="{loc:Tr AudioPreviewNote}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
