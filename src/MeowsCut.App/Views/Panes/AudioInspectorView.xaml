<UserControl x:Class="MeowsCut.App.Views.Panes.AudioInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:fmt="clr-namespace:MeowsCut.App.Formatting"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AudioInspectorViewModel}">

    <UserControl.Resources>
        <!-- Отпустили ползунок — склейка правок в истории заканчивается. Без этого
             вся работа со звуком за сеанс становилась одной записью, а Ctrl+Z
             возвращал кусок к исходному состоянию. -->
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="controls:SliderInteraction.EndCommand" Value="{Binding EndInteractionCommand}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="12,8"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Text.Section}"
                           Text="{loc:Tr SectionSound}" />
                <TextBlock Margin="10,0,0,0"
                           MaxWidth="180"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Base}"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding RangeText}" />

                <Border Width="1" Margin="12,2" Background="{StaticResource Brush.Border}" />

                <!-- Ползунок и его число — одной группой: при переносе строки
                     они обязаны остаться вместе. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr FieldGain}" />
                    <Slider Width="100"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="400"
                            Minimum="0"
                            TickFrequency="5"
                            Value="{Binding GainPercent}" />
                    <TextBlock Width="44"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding GainPercent, StringFormat={}{0:0}%}" />
                </StackPanel>

                <Border Width="1" Margin="12,2" Background="{StaticResource Brush.Border}" />

                <StackPanel Orientation="Horizontal" ToolTip="{loc:Tr FieldPitchHint}">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr FieldPitch}" />
                    <Slider Width="120"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="12"
                            Minimum="-12"
                            TickFrequency="1"
                            Value="{Binding PitchSemitones}" />
                    <TextBlock Width="86"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding PitchSemitones, StringFormat={}{0:+#;-#;0} пт}" />
                </StackPanel>

                <Border Width="1" Margin="12,2" Background="{StaticResource Brush.Border}" />

                <!-- Скорость звука отдельно от скорости клипа: музыку подгоняют под
                     монтаж, а не наоборот, и от картинки она не зависит. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr FieldSpeed}" />
                    <Slider Width="120"
                            VerticalAlignment="Center"
                            LargeChange="1"
                            Maximum="{x:Static fmt:SpeedScale.Max}"
                            Minimum="{x:Static fmt:SpeedScale.Min}"
                            SmallChange="0.08"
                            ToolTip="{loc:Tr FieldSpeedHint}"
                            Value="{Binding SpeedSlider}" />
                    <TextBox Width="54"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Padding="6,4"
                             Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Tr FieldSpeedCustomHint}" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="×" />
                </StackPanel>

                <Border Width="1" Margin="12,2" Background="{StaticResource Brush.Border}" />

                <CheckBox VerticalAlignment="Center"
                          Content="{loc:Tr TrackMuted}"
                          IsChecked="{Binding TrackMuted}"
                          Command="{Binding ToggleMutedCommand}" />

                <Button Margin="12,0,0,0"
                        Command="{Binding RemoveTrackCommand}"
                        Content="{loc:Tr RemoveTrack}"
                        Style="{StaticResource Button.Ghost}" />
            </WrapPanel>

            <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                <!-- У каждого ползунка своё число рядом: без него непонятно,
                     сколько именно секунд нарастания получилось. -->
                <StackPanel Orientation="Horizontal" ToolTip="{loc:Tr FieldFadeInHint}">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr FieldFadeIn}" />
                    <Slider Width="90"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="5"
                            Minimum="0"
                            TickFrequency="0.1"
                            Value="{Binding FadeInSeconds}" />
                    <TextBlock Width="52"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding FadeInSeconds, StringFormat={}{0:0.0} с}" />
                </StackPanel>

                <StackPanel Margin="12,0,0,0" Orientation="Horizontal" ToolTip="{loc:Tr FieldFadeOutHint}">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{loc:Tr FieldFadeOut}" />
                    <Slider Width="90"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="5"
                            Minimum="0"
                            TickFrequency="0.1"
                            Value="{Binding FadeOutSeconds}" />
                    <TextBlock Width="52"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding FadeOutSeconds, StringFormat={}{0:0.0} с}" />
                </StackPanel>

                <Border Width="1" Margin="12,2" Background="{StaticResource Brush.Border}" />

                <StackPanel Orientation="Horizontal" ToolTip="{loc:Tr FieldTrackGainHint}">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding TrackTitle}" />
                    <Slider Width="90"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="400"
                            Minimum="0"
                            TickFrequency="5"
                            Value="{Binding TrackGainPercent}" />
                    <TextBlock Width="48"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding TrackGainPercent, StringFormat={}{0:0}%}" />
                </StackPanel>

                <TextBlock Margin="16,0,0,0"
                           MaxWidth="280"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Tr AudioPreviewNote}"
                           TextWrapping="Wrap" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
