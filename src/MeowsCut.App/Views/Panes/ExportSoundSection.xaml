<UserControl x:Class="MeowsCut.App.Views.Panes.ExportSoundSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowsCut.App.Controls"
             xmlns:loc="clr-namespace:MeowsCut.App.Localization"
             xmlns:vm="clr-namespace:MeowsCut.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ExportViewModel}">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <!-- Раздел «Звук и субтитры» окна экспорта -->
    <StackPanel Grid.IsSharedSizeScope="True">
        <CheckBox Margin="0,0,0,10"
                  Content="{loc:Tr KeepAudio}"
                  IsChecked="{Binding KeepAudio}"
                  Visibility="{Binding HasVideoOutput, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Visibility="{Binding KeepAudio, Converter={StaticResource BoolToVisibility}}">
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldAudioCodec}" />
                    <ComboBox ItemTemplate="{StaticResource EnumLabelTemplate}" ItemsSource="{Binding AvailableAudioCodecs}" SelectedItem="{Binding AudioCodec}" Style="{StaticResource FieldBox}" />
                </StackPanel>
                <StackPanel Margin="6,0,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldAudioBitrate}" />
                    <ComboBox ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding AudioBitrateKbps}" Style="{StaticResource FieldBox}" />
                </StackPanel>
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldSampleRate}" />
                    <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding AudioSampleRateHz}" Style="{StaticResource FieldBox}" />
                </StackPanel>
                <StackPanel Margin="6,0,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr FieldChannels}" />
                    <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding AudioChannels}" Style="{StaticResource FieldBox}" />
                </StackPanel>
            </UniformGrid>

            <controls:ParamRow Icon="{StaticResource Icon.Volume}" Label="{loc:Tr FieldMasterVolume}">
                <Slider IsSnapToTickEnabled="True" Maximum="200" Minimum="0" TickFrequency="5" Value="{Binding MasterVolumePercent}" />
                <controls:ParamRow.Trailing>
                    <controls:NumberBox Format="0" Maximum="200" Minimum="0" Step="1" Style="{StaticResource FieldNumber}" Suffix="%" Value="{Binding MasterVolumePercent}" />
                </controls:ParamRow.Trailing>
            </controls:ParamRow>

            <CheckBox Margin="0,8,0,12"
                      Content="{loc:Tr FieldNormalizeLoudness}"
                      IsChecked="{Binding NormalizeLoudness}"
                      ToolTip="{loc:Tr FieldNormalizeLoudnessHint}" />
        </StackPanel>

        <!-- Субтитры: файл SRT/ASS, вшить в кадр или отдельной дорожкой -->
        <StackPanel Visibility="{Binding HasVideoOutput, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,4,0,6" Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Subtitles}" Style="{StaticResource FieldIcon}" />
                <TextBlock FontWeight="SemiBold" Style="{StaticResource Text.Base}" Text="{loc:Tr SectionSubtitles}" />
            </StackPanel>

            <DockPanel Margin="0,0,0,8">
                <Button Command="{Binding ChooseSubtitlesCommand}"
                        Content="{loc:Tr ChooseSubtitles}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource SoftButton}"
                        Visibility="{Binding HasSubtitles, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Command="{Binding ClearSubtitlesCommand}"
                        Content="{loc:Tr ClearSubtitles}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource FlatButton}"
                        Visibility="{Binding HasSubtitles, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Text.Base}"
                           Text="{Binding SubtitleFileName}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SubtitlePath}" />
            </DockPanel>

            <StackPanel Visibility="{Binding HasSubtitles, Converter={StaticResource BoolToVisibility}}">
                <ComboBox ItemsSource="{Binding SubtitleModes}" SelectedItem="{Binding SubtitleMode}" Style="{StaticResource FieldBox}" />
                <TextBlock Margin="0,-6,0,4" Style="{StaticResource Text.Caption}" Text="{loc:Tr SubtitleBurnHint}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
